<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ========================================= -->
        <!-- CRON JOB: Criar Snapshots Mensais de AUM -->
        <!-- ========================================= -->
        <record id="cron_create_monthly_aum_snapshots" model="ir.cron">
            <field name="name">Finance: Criar Snapshots Mensais de AUM</field>
            <field name="model_id" ref="model_finance_aum_snapshot"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_monthly_snapshots()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="priority">1</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1) + timedelta(days=32)).replace(day=1, hour=2, minute=0)"/>
        </record>
        
    </data>
</odoo>
