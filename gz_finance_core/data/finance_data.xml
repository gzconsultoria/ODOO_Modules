<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ====================================== -->
        <!-- SEQUENCE FOR PROFILE ID                -->
        <!-- ====================================== -->
        <record id="sequence_finance_profile" model="ir.sequence">
            <field name="name">Finance Profile ID</field>
            <field name="code">finance.profile</field>
            <field name="prefix">FIN-%(day)s.%(month)s.%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- ====================================== -->
        <!-- CONFIGURATION PARAMETERS               -->
        <!-- ====================================== -->
        
        <!-- Client Segmentation Thresholds -->
        <record id="config_retail_max" model="ir.config_parameter">
            <field name="key">finance_core.retail_max</field>
            <field name="value">100000</field>
        </record>

        <record id="config_affluent_max" model="ir.config_parameter">
            <field name="key">finance_core.affluent_max</field>
            <field name="value">1000000</field>
        </record>

        <record id="config_hnw_max" model="ir.config_parameter">
            <field name="key">finance_core.hnw_max</field>
            <field name="value">10000000</field>
        </record>

        <!-- KYC Configuration -->
        <record id="config_kyc_validity_months" model="ir.config_parameter">
            <field name="key">finance_core.kyc_validity_months</field>
            <field name="value">12</field>
        </record>

        <record id="config_kyc_notification_days" model="ir.config_parameter">
            <field name="key">finance_core.kyc_expiry_notification_days</field>
            <field name="value">30</field>
        </record>

        <!-- ====================================== -->
        <!-- DEFAULT FINANCE CATEGORIES             -->
        <!-- ====================================== -->
        <record id="category_high_value" model="finance.category">
            <field name="name">High Value Client</field>
            <field name="sequence">10</field>
            <field name="color">3</field>
            <field name="description">Clients with high AUM or potential</field>
        </record>

        <record id="category_vip" model="finance.category">
            <field name="name">VIP</field>
            <field name="sequence">20</field>
            <field name="color">5</field>
            <field name="description">VIP clients requiring special attention</field>
        </record>

        <record id="category_institutional" model="finance.category">
            <field name="name">Institutional</field>
            <field name="sequence">30</field>
            <field name="color">7</field>
            <field name="description">Institutional investors</field>
        </record>

        <record id="category_at_risk" model="finance.category">
            <field name="name">At Risk</field>
            <field name="sequence">40</field>
            <field name="color">1</field>
            <field name="description">Clients at risk of churning</field>
        </record>

        <record id="category_referral_source" model="finance.category">
            <field name="name">Referral Source</field>
            <field name="sequence">50</field>
            <field name="color">9</field>
            <field name="description">Clients who refer other clients</field>
        </record>

    </data>
</odoo>
