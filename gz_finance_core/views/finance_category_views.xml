<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ====================================== -->
    <!-- CATEGORY TREE VIEW                     -->
    <!-- ====================================== -->
    <record id="view_finance_category_tree" model="ir.ui.view">
        <field name="name">finance.category.tree</field>
        <field name="model">finance.category</field>
        <field name="arch" type="xml">
            <list string="Categorias Financeiras">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="partner_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- CATEGORY FORM VIEW                     -->
    <!-- ====================================== -->
    <record id="view_finance_category_form" model="ir.ui.view">
        <field name="name">finance.category.form</field>
        <field name="model">finance.category</field>
        <field name="arch" type="xml">
            <form string="Categoria Financeira">
                <sheet>
                    <widget name="web_ribbon" title="Arquivado" bg_color="text-bg-danger" invisible="active"/>
                    
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    
                    <group string="Descrição">
                        <field name="description" nolabel="1" placeholder="Descreva esta categoria..."/>
                    </group>
                    
                    <notebook>
                        <page string="Clientes" name="clients">
                            <field name="partner_ids" nolabel="1">
                                <list>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="aum" widget="monetary"/>
                                    <field name="advisor_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- CATEGORY SEARCH VIEW                   -->
    <!-- ====================================== -->
    <record id="view_finance_category_search" model="ir.ui.view">
        <field name="name">finance.category.search</field>
        <field name="model">finance.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                
                <filter string="Ativo" name="active" domain="[('active', '=', True)]"/>
                <filter string="Arquivado" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- ACTION: FINANCE CATEGORIES             -->
    <!-- ====================================== -->
    <record id="action_finance_categories" model="ir.actions.act_window">
        <field name="name">Categorias de Clientes</field>
        <field name="res_model">finance.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_active': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie sua primeira categoria!
            </p>
            <p>
                Categorias ajudam você a organizar e segmentar seus clientes de consultoria financeira.
            </p>
        </field>
    </record>

</odoo>
