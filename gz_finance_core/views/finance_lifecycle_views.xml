<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ====================================== -->
    <!-- LIFECYCLE TREE VIEW                    -->
    <!-- ====================================== -->
    <record id="view_finance_lifecycle_tree" model="ir.ui.view">
        <field name="name">finance.lifecycle.tree</field>
        <field name="model">finance.lifecycle</field>
        <field name="arch" type="xml">
            <list decoration-info="stage == 'lead'"
                  decoration-success="stage == 'active'"
                  decoration-warning="stage == 'churning'"
                  decoration-danger="stage == 'churned'">
                <field name="partner_id"/>
                <field name="changed_date"/>
                <field name="previous_stage" optional="show"/>
                <field name="stage" widget="badge"/>
                <field name="reason" optional="show"/>
                <field name="days_in_stage"/>
                <field name="changed_by"/>
            </list>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- LIFECYCLE FORM VIEW                    -->
    <!-- ====================================== -->
    <record id="view_finance_lifecycle_form" model="ir.ui.view">
        <field name="name">finance.lifecycle.form</field>
        <field name="model">finance.lifecycle</field>
        <field name="arch" type="xml">
            <form string="Lifecycle History" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="previous_stage" widget="badge"/>
                            <field name="stage" widget="badge"/>
                        </group>
                        <group>
                            <field name="changed_date"/>
                            <field name="changed_by"/>
                            <field name="days_in_stage"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                    <group>
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- LIFECYCLE SEARCH VIEW                  -->
    <!-- ====================================== -->
    <record id="view_finance_lifecycle_search" model="ir.ui.view">
        <field name="name">finance.lifecycle.search</field>
        <field name="model">finance.lifecycle</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="stage"/>
                <field name="changed_by"/>
                
                <filter string="Lead" name="stage_lead" domain="[('stage', '=', 'lead')]"/>
                <filter string="Active" name="stage_active" domain="[('stage', '=', 'active')]"/>
                <filter string="VIP" name="stage_vip" domain="[('stage', '=', 'vip')]"/>
                
                <separator/>
                <filter name="group_partner" string="Client" context="{'group_by':'partner_id'}"/>
                <filter name="group_stage" string="Stage" context="{'group_by':'stage'}"/>
            </search>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- ACTION: LIFECYCLE HISTORY              -->
    <!-- ====================================== -->
    <record id="action_finance_lifecycle" model="ir.actions.act_window">
        <field name="name">Lifecycle History</field>
        <field name="res_model">finance.lifecycle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No lifecycle history yet
            </p>
            <p>
                Lifecycle changes are automatically tracked when you update client stages.
            </p>
        </field>
    </record>

</odoo>
