<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ====================================== -->
    <!-- PARTNER LIST VIEW - CLIENTES FINANCEIROS -->
    <!-- ====================================== -->
    <record id="view_partner_finance_tree" model="ir.ui.view">
        <field name="name">res.partner.finance.tree</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Clientes sob Gestão">
                <field name="finance_profile_id" string="Finance ID" width="120px"/>
                <field name="name" string="Nome" width="180px"/>
                <field name="city" string="Cidade" width="120px" optional="show"/>
                <field name="email" width="200px"/>
                <field name="phone" string="Telefone" width="130px"/>
                <field name="aum" widget="monetary" string="AUM" width="120px"
                       class="text-end"
                       decoration-muted="aum == 0"
                       optional="show"/>
                <field name="risk_profile" string="Perfil de Risco" width="130px"
                       decoration-muted="not risk_profile"
                       optional="show"/>
                <field name="suitability_last_review" string="Última Reunião" width="120px"
                       optional="show"/>
                <field name="activity_ids" widget="list_activity" width="80px"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    
    <!-- ====================================== -->
    <!-- PARTNER FORM VIEW INHERITANCE          -->
    <!-- ====================================== -->
    <record id="view_partner_form_finance" model="ir.ui.view">
        <field name="name">res.partner.form.finance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            
            <!-- Add Finance Client Toggle -->
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_finance_client" string="Cliente Consultoria" widget="boolean_toggle"/>
            </xpath>
            
            <!-- Add Smart Buttons for Finance Data -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_patrimony_history"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-line-chart"
                        groups="gz_finance_core.group_finance_user"
                        invisible="not is_finance_client">
                    <field name="patrimony_count" widget="statinfo" string="Snapshots"/>
                </button>
            </xpath>
            
            <!-- Add Finance Tab -->
            <xpath expr="//notebook" position="inside">
                <page string="💼 Consultoria" 
                      name="finance" 
                      invisible="not is_finance_client"
                      groups="gz_finance_core.group_finance_user">
                    
                    <!-- Hidden field for monetary widget -->
                    <field name="currency_id" invisible="1"/>
                    
                    <!-- IDENTIFICAÇÃO E SEGMENTAÇÃO -->
                    <group name="finance_identification" string="Identificação">
                        <group>
                            <field name="finance_profile_id" readonly="1" 
                                   force_save="1"
                                   string="🆔 ID Perfil Financeiro"
                                   placeholder="Será gerado automaticamente ao salvar"
                                   groups="gz_finance_core.group_finance_user,base.group_system"/>
                            <field name="client_segment" readonly="1" widget="badge"
                                   decoration-info="client_segment == 'retail'"
                                   decoration-success="client_segment == 'affluent'"
                                   decoration-warning="client_segment == 'high_net_worth'"
                                   decoration-danger="client_segment == 'ultra_high_net_worth'"/>
                        </group>
                        <group>
                            <field name="advisor_id" options="{'no_create': True}"/>
                            <field name="advisor_team_id" options="{'no_create': True}"/>
                            <field name="finance_category_ids" 
                                   widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                    </group>
                    
                    <!-- SUB-ABAS -->
                    <notebook>
                        
                        <!-- ABA 1: PATRIMÔNIO E AUM -->
                        <page string="💎 Patrimônio" name="patrimony_tab">
                            <group>
                                <group string="AUM Atual">
                                    <field name="aum" widget="monetary" class="oe_read_only"/>
                                    <field name="aum_growth_percent" widget="percentage" readonly="1"
                                           decoration-success="aum_growth_percent &gt; 0"
                                           decoration-danger="aum_growth_percent &lt; 0"
                                           decoration-muted="aum_growth_percent == 0"/>
                                    <field name="aum_updated_at" readonly="1"/>
                                    <button name="action_update_aum" 
                                            string="Atualizar AUM" 
                                            type="object" 
                                            class="btn-primary"
                                            icon="fa-refresh"/>
                                </group>
                                <group string="Situação Financeira">
                                    <field name="annual_income" widget="monetary"/>
                                    <field name="monthly_expenses" widget="monetary"/>
                                    <field name="saving_capacity" widget="monetary" readonly="1"
                                           decoration-success="saving_capacity &gt; 0"
                                           decoration-danger="saving_capacity &lt;= 0"/>
                                    <field name="emergency_fund_months"/>
                                </group>
                            </group>
                            
                            <separator string="Histórico de Snapshots"/>
                            <field name="finance_patrimony_ids" nolabel="1">
                                <list>
                                    <field name="date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="total_value" widget="monetary" sum="Total"/>
                                    <field name="variation_percent" widget="percentage"
                                           decoration-success="variation_percent &gt; 0"
                                           decoration-danger="variation_percent &lt; 0"/>
                                    <field name="source" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- ABA 2: DADOS ESTRATÉGICOS -->
                        <page string="🎯 Dados Estratégicos" name="personal_data_tab">
                            <group>
                                <group string="Informações Pessoais">
                                    <field name="birthdate_finance"/>
                                    <field name="age" readonly="1"/>
                                    <field name="days_to_birthday" readonly="1" 
                                           decoration-info="days_to_birthday &lt; 30"
                                           decoration-warning="days_to_birthday &lt; 7"/>
                                    <field name="marital_status"/>
                                    <field name="spouse_name" invisible="marital_status != 'married'"/>
                                    <field name="spouse_birthdate" invisible="marital_status != 'married'"/>
                                </group>
                                <group string="Filhos">
                                    <field name="children_count"/>
                                    <field name="children_names" widget="text" invisible="children_count == 0"/>
                                </group>
                            </group>
                            
                            <group>
                                <group string="Interesses &amp; Estilo de Vida">
                                    <field name="favorite_team"/>
                                    <field name="hobby" widget="text"/>
                                    <field name="practices_sports"/>
                                    <field name="sports_details" invisible="not practices_sports" 
                                           placeholder="Especifique qual(is) esporte(s)"/>
                                    <field name="vehicle"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- ABA 3: OBJETIVOS FINANCEIROS -->
                        <page string="🎯 Objetivos" name="goals_tab">
                            <group>
                                <group string="Objetivo Principal">
                                    <field name="main_goal"/>
                                    <field name="short_term_goal" widget="text"/>
                                    <field name="long_term_goal" widget="text"/>
                                </group>
                                <group string="Meta Financeira">
                                    <field name="goal_amount" widget="monetary"/>
                                    <field name="goal_deadline_years"/>
                                    <field name="monthly_contribution_needed" widget="monetary" readonly="1"
                                           decoration-info="monthly_contribution_needed > 0"/>
                                    <p class="text-muted" invisible="not monthly_contribution_needed">
                                        Com base no perfil de risco <field name="risk_profile" invisible="1"/> 
                                        e prazo definido, o cliente precisa investir este valor mensalmente.
                                    </p>
                                </group>
                            </group>
                        </page>
                        
                        <!-- ABA 4: MODELO DE GESTÃO -->
                        <page string="💼 Modelo de Gestão" name="proposal_tab"
                              groups="gz_finance_core.group_finance_advisor">
                            <group>
                                <group string="Dados da Proposta">
                                    <field name="proposal_date"/>
                                    <field name="proposal_amount" widget="monetary"/>
                                    <field name="contract_type"/>
                                </group>
                                <group string="Precificação">
                                    <field name="management_fee" widget="percentage"/>
                                    <field name="estimated_annual_revenue" widget="monetary" readonly="1"
                                           decoration-success="estimated_annual_revenue > 0"/>
                                </group>
                            </group>
                            <group string="Justificativa Comercial" colspan="2" col="1">
                                <field name="proposal_justification" widget="html" nolabel="1" 
                                       placeholder="Digite &quot;/&quot; para comandos"/>
                            </group>
                        </page>
                        
                        <!-- ABA 5: COMPLIANCE E SUITABILITY -->
                        <page string="🔐 Compliance" name="compliance_tab">
                            <group>
                                <group string="KYC (Know Your Client)">
                                    <field name="kyc_status" widget="badge"
                                           decoration-success="kyc_status == 'completed'"
                                           decoration-warning="kyc_status in ('pending', 'in_progress')"
                                           decoration-danger="kyc_status in ('expired', 'rejected')"/>
                                    <field name="kyc_completed_date"/>
                                    <field name="kyc_expiry_date"
                                           decoration-danger="kyc_expiry_date and kyc_expiry_date &lt; context_today().strftime('%Y-%m-%d')"/>
                                    <field name="kyc_needs_renewal" invisible="1"/>
                                    <div class="alert alert-warning" role="alert" 
                                         invisible="not kyc_needs_renewal">
                                        <i class="fa fa-exclamation-triangle"/> <strong>Atenção:</strong> KYC vence em menos de 30 dias!
                                    </div>
                                    <field name="is_pep"/>
                                </group>
                                <group string="Suitability (Adequação)">
                                    <field name="risk_profile" widget="badge"
                                           decoration-info="risk_profile == 'conservative'"
                                           decoration-success="risk_profile == 'moderate'"
                                           decoration-warning="risk_profile == 'aggressive'"/>
                                    <field name="suitability_score" widget="progressbar"/>
                                    <field name="suitability_last_review"/>
                                    <field name="suitability_next_review" readonly="1"
                                           decoration-warning="suitability_next_review and suitability_next_review &lt; context_today().strftime('%Y-%m-%d')"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- ABA 6: DIAGNÓSTICO FINANCEIRO -->
                        <page string="🔍 Diagnóstico" name="diagnosis_tab">
                            <group>
                                <field name="diagnosis_date"/>
                            </group>
                            <group col="3">
                                <field name="diagnosis_strengths" widget="html" string="✅ Pontos Fortes"/>
                                <field name="diagnosis_weaknesses" widget="html" string="⚠️ Pontos a Melhorar"/>
                                <field name="diagnosis_opportunities" widget="html" string="💡 Oportunidades"/>
                            </group>
                        </page>
                        
                        <!-- ABA 7: OBSERVAÇÕES -->
                        <page string="📝 Observações" name="notes_tab">
                            <field name="finance_notes" widget="html" nolabel="1" 
                                   placeholder="Anotações gerais sobre o cliente, reuniões, estratégias discutidas..."/>
                        </page>
                        
                    </notebook>
                    
                </page>
            </xpath>
            
            <!-- Add Smart Buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_finance_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="not is_finance_client"
                        groups="gz_finance_core.group_finance_advisor">
                    <field name="finance_invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </xpath>
            
        </field>
    </record>

    <!-- ====================================== -->
    <!-- ACTION: FINANCE CLIENTS                -->
    <!-- ====================================== -->
    <record id="action_finance_clients" model="ir.actions.act_window">
        <field name="name">Clientes sob Gestão</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_partner_finance_tree"/>
        <field name="context">{'default_is_finance_client': True}</field>
        <field name="domain">[('is_finance_client', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie seu primeiro cliente sob gestão!
            </p>
            <p>
                Clientes sob gestão são acompanhados com AUM e status de compliance.
            </p>
        </field>
    </record>

</odoo>
