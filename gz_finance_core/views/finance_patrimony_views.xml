<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ====================================== -->
    <!-- PATRIMONY TREE VIEW                    -->
    <!-- ====================================== -->
    <record id="view_finance_patrimony_tree" model="ir.ui.view">
        <field name="name">finance.patrimony.tree</field>
        <field name="model">finance.patrimony</field>
        <field name="arch" type="xml">
            <list decoration-success="variation_percent > 0" 
                  decoration-danger="variation_percent &lt; 0"
                  editable="bottom">
                <field name="partner_id"/>
                <field name="date"/>
                <field name="fixed_income" sum="Total"/>
                <field name="equities" sum="Total"/>
                <field name="funds" sum="Total"/>
                <field name="real_estate" sum="Total" optional="hide"/>
                <field name="alternatives" sum="Total" optional="hide"/>
                <field name="cash" sum="Total" optional="hide"/>
                <field name="total_value" sum="Total AUM"/>
                <field name="previous_total" optional="show"/>
                <field name="variation_amount" optional="show"/>
                <field name="variation_percent" widget="percentage"/>
                <field name="source" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- PATRIMONY FORM VIEW                    -->
    <!-- ====================================== -->
    <record id="view_finance_patrimony_form" model="ir.ui.view">
        <field name="name">finance.patrimony.form</field>
        <field name="model">finance.patrimony</field>
        <field name="arch" type="xml">
            <form string="Histórico de Patrimônio">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="total_value" widget="monetary"/>
                            <field name="previous_total" widget="monetary" readonly="1"/>
                            <field name="variation_amount" widget="monetary" readonly="1"/>
                            <field name="variation_percent" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Composição de Ativos">
                            <group>
                                <group string="Ativos Tradicionais">
                                    <field name="fixed_income" widget="monetary"/>
                                    <field name="equities" widget="monetary"/>
                                    <field name="funds" widget="monetary"/>
                                </group>
                                <group string="Ativos Alternativos">
                                    <field name="real_estate" widget="monetary"/>
                                    <field name="alternatives" widget="monetary"/>
                                    <field name="cash" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Observações">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- PATRIMONY SEARCH VIEW                  -->
    <!-- ====================================== -->
    <record id="view_finance_patrimony_search" model="ir.ui.view">
        <field name="name">finance.patrimony.search</field>
        <field name="model">finance.patrimony</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="date"/>
                
                <filter string="Entrada Manual" name="source_manual" domain="[('source', '=', 'manual')]"/>
                <filter string="Integração" name="source_integration" domain="[('source', '=', 'custody_integration')]"/>
                
                <separator/>
                <filter name="group_partner" string="Cliente" context="{'group_by':'partner_id'}"/>
                <filter name="group_date" string="Data" context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- PATRIMONY GRAPH VIEW                   -->
    <!-- ====================================== -->
    <record id="view_finance_patrimony_graph" model="ir.ui.view">
        <field name="name">finance.patrimony.graph</field>
        <field name="model">finance.patrimony</field>
        <field name="arch" type="xml">
            <graph string="Evolução Patrimonial" type="line">
                <field name="date" interval="month"/>
                <field name="total_value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- PATRIMONY PIVOT VIEW                   -->
    <!-- ====================================== -->
    <record id="view_finance_patrimony_pivot" model="ir.ui.view">
        <field name="name">finance.patrimony.pivot</field>
        <field name="model">finance.patrimony</field>
        <field name="arch" type="xml">
            <pivot string="Análise Patrimonial">
                <field name="partner_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="total_value" type="measure"/>
                <field name="fixed_income" type="measure"/>
                <field name="equities" type="measure"/>
                <field name="funds" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ====================================== -->
    <!-- ACTION: PATRIMONY SNAPSHOTS            -->
    <!-- ====================================== -->
    <record id="action_finance_patrimony" model="ir.actions.act_window">
        <field name="name">Histórico de Patrimônio</field>
        <field name="res_model">finance.patrimony</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie seu primeiro snapshot de patrimônio!
            </p>
            <p>
                Acompanhe os ativos dos clientes ao longo do tempo para calcular AUM e performance.
            </p>
        </field>
    </record>

</odoo>
