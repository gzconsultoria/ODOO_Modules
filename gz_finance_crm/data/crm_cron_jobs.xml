<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ========================================= -->
        <!-- CRON JOB: Detecção de Risco de Churn     -->
        <!-- ========================================= -->
        <record id="cron_detect_churn_risk" model="ir.cron">
            <field name="name">CRM: Detectar Risco de Churn</field>
            <field name="model_id" ref="model_crm_churn_indicator"/>
            <field name="state">code</field>
            <field name="code">model._cron_detect_churn_risk()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
        
        <!-- ========================================= -->
        <!-- CRON JOB: Detecção de Cross-Sell         -->
        <!-- ========================================= -->
        <record id="cron_detect_crosssell" model="ir.cron">
            <field name="name">CRM: Detectar Oportunidades Cross-Sell</field>
            <field name="model_id" ref="model_crm_crosssell_opportunity"/>
            <field name="state">code</field>
            <field name="code">model._cron_detect_crosssell_opportunities()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
        
        <!-- ========================================= -->
        <!-- CRON JOB: Limpeza de Audit Logs Antigos  -->
        <!-- ========================================= -->
        <record id="cron_cleanup_audit_logs" model="ir.cron">
            <field name="name">CRM: Limpar Audit Logs Antigos (+365 dias)</field>
            <field name="model_id" ref="model_crm_audit_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=3, minute=0)"/>
        </record>
        
        <!-- ========================================= -->
        <!-- CRON JOB: Detecção de Divergências        -->
        <!-- ========================================= -->
        <record id="cron_detect_data_divergence" model="ir.cron">
            <field name="name">CRM: Detectar Divergências CRM↔Finance</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_detect_data_divergence()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=9, minute=0)"/>
        </record>
        
    </data>
</odoo>
