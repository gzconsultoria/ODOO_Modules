<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- CHURN INDICATOR: TREE VIEW                   -->
    <!-- ============================================ -->
    <record id="view_crm_churn_indicator_tree" model="ir.ui.view">
        <field name="name">crm.churn.indicator.tree</field>
        <field name="model">crm.churn.indicator</field>
        <field name="arch" type="xml">
            <list string="Indicadores de Churn" default_order="churn_risk_score desc">
                <field name="partner_id"/>
                <field name="current_aum" widget="monetary"/>
                <field name="aum_decline_percent" widget="percentage"/>
                <field name="days_since_last_meeting"/>
                <field name="churn_risk_score" widget="progressbar"/>
                <field name="risk_level" widget="badge"
                       decoration-success="risk_level == 'low'"
                       decoration-warning="risk_level == 'medium'"
                       decoration-danger="risk_level == 'high'"
                       decoration-bf="risk_level == 'critical'"/>
                <field name="alert_created" widget="boolean_toggle"/>
                <field name="last_check_date"/>
                <button name="action_create_retention_lead" string="Criar Alerta" 
                        type="object" class="btn-primary"
                        invisible="alert_created"/>
            </list>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- CHURN INDICATOR: FORM VIEW                   -->
    <!-- ============================================ -->
    <record id="view_crm_churn_indicator_form" model="ir.ui.view">
        <field name="name">crm.churn.indicator.form</field>
        <field name="model">crm.churn.indicator</field>
        <field name="arch" type="xml">
            <form string="Indicador de Churn">
                <header>
                    <button name="action_create_retention_lead" string="Criar Lead de Retenção" 
                            type="object" class="btn-primary"
                            invisible="alert_created"/>
                    <field name="risk_level" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_retention_lead" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="not alert_created">
                            <field name="alert_lead_id" widget="statinfo" string="Lead de Retenção"/>
                        </button>
                    </div>
                    
                    <group>
                        <group name="client_info">
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </group>
                        <group name="risk_info">
                            <field name="churn_risk_score" widget="progressbar"/>
                            <field name="risk_level"/>
                            <field name="last_check_date"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Métricas de AUM">
                            <group>
                                <group>
                                    <field name="current_aum" widget="monetary"/>
                                    <field name="aum_3months_ago" widget="monetary"/>
                                </group>
                                <group>
                                    <field name="aum_decline_percent" widget="percentage"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Engajamento">
                            <group>
                                <group>
                                    <field name="last_meeting_date"/>
                                    <field name="days_since_last_meeting"/>
                                </group>
                                <group>
                                    <field name="meetings_last_6months"/>
                                    <field name="response_rate" widget="percentage"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Alertas">
                            <group>
                                <field name="alert_created" widget="boolean_toggle"/>
                                <field name="alert_date"/>
                                <field name="alert_lead_id"/>
                            </group>
                        </page>
                    </notebook>
                    
                    <field name="notes" placeholder="Observações sobre risco de churn..."/>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- KANBAN VIEW                                  -->
    <!-- ============================================ -->
    <record id="view_crm_churn_indicator_kanban" model="ir.ui.view">
        <field name="name">crm.churn.indicator.kanban</field>
        <field name="model">crm.churn.indicator</field>
        <field name="arch" type="xml">
            <kanban default_group_by="risk_level">
                <field name="partner_id"/>
                <field name="churn_risk_score"/>
                <field name="risk_level"/>
                <field name="current_aum"/>
                <field name="aum_decline_percent"/>
                <field name="days_since_last_meeting"/>
                <field name="alert_created"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_card_header">
                                    <strong><field name="partner_id"/></strong>
                                </div>
                                <div class="oe_kanban_card_body">
                                    <div>Score: <field name="churn_risk_score"/>%</div>
                                    <div>AUM: <field name="current_aum" widget="monetary"/></div>
                                    <div>Queda: <field name="aum_decline_percent"/>%</div>
                                    <div>Dias sem reunião: <field name="days_since_last_meeting"/></div>
                                </div>
                                <div class="oe_kanban_card_footer">
                                    <button name="action_create_retention_lead" type="object" 
                                            class="btn btn-sm btn-primary" 
                                            invisible="alert_created">
                                        Criar Alerta
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- ACTIONS                                      -->
    <!-- ============================================ -->
    <record id="action_crm_churn_indicator" model="ir.actions.act_window">
        <field name="name">Risco de Churn</field>
        <field name="res_model">crm.churn.indicator</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhum indicador de churn detectado
            </p>
            <p>
                Os indicadores de risco aparecem aqui automaticamente.
            </p>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- MENUS                                        -->
    <!-- ============================================ -->
    <menuitem id="menu_crm_churn_prevention"
              name="Prevenção de Churn"
              parent="crm.crm_menu_sales"
              action="action_crm_churn_indicator"
              sequence="50"/>
    
</odoo>
