<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- CROSSSELL OPPORTUNITY: TREE VIEW             -->
    <!-- ============================================ -->
    <record id="view_crm_crosssell_opportunity_tree" model="ir.ui.view">
        <field name="name">crm.crosssell.opportunity.tree</field>
        <field name="model">crm.crosssell.opportunity</field>
        <field name="arch" type="xml">
            <list string="Oportunidades de Cross-Sell" default_order="opportunity_score desc">
                <field name="partner_id"/>
                <field name="opportunity_type"/>
                <field name="opportunity_score" widget="progressbar"/>
                <field name="current_aum" widget="monetary"/>
                <field name="aum_growth_percent" widget="percentage"/>
                <field name="estimated_additional_aum" widget="monetary"/>
                <field name="estimated_additional_revenue" widget="monetary"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'new'"
                       decoration-warning="status == 'contacted'"
                       decoration-success="status == 'won'"/>
                <field name="detection_date"/>
                <button name="action_create_crosssell_lead" string="Criar Lead" 
                        type="object" class="btn-primary"
                        invisible="lead_created"/>
            </list>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- CROSSSELL OPPORTUNITY: FORM VIEW             -->
    <!-- ============================================ -->
    <record id="view_crm_crosssell_opportunity_form" model="ir.ui.view">
        <field name="name">crm.crosssell.opportunity.form</field>
        <field name="model">crm.crosssell.opportunity</field>
        <field name="arch" type="xml">
            <form string="Oportunidade de Cross-Sell">
                <header>
                    <button name="action_create_crosssell_lead" string="Criar Lead de Cross-Sell" 
                            type="object" class="btn-primary"
                            invisible="lead_created"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_crosssell_lead" type="object"
                                class="oe_stat_button" icon="fa-dollar"
                                invisible="not lead_created">
                            <field name="lead_id" widget="statinfo" string="Lead Cross-Sell"/>
                        </button>
                    </div>
                    
                    <group>
                        <group name="client_info">
                            <field name="partner_id"/>
                            <field name="opportunity_type"/>
                            <field name="detection_date"/>
                            <field name="currency_id" column_invisible="1"/>
                        </group>
                        <group name="score_info">
                            <field name="opportunity_score" widget="progressbar"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Métricas Financeiras">
                            <group>
                                <group string="AUM">
                                    <field name="current_aum" widget="monetary"/>
                                    <field name="aum_growth_percent" widget="percentage"/>
                                    <field name="estimated_wealth" widget="monetary"/>
                                    <field name="aum_divergence" widget="percentage"/>
                                </group>
                                <group string="Potencial">
                                    <field name="estimated_additional_aum" widget="monetary"/>
                                    <field name="estimated_additional_revenue" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Descrição">
                            <field name="description" placeholder="Descrição detalhada da oportunidade..."/>
                        </page>
                        
                        <page string="Ações Sugeridas">
                            <field name="suggested_actions" placeholder="Ações recomendadas..."/>
                        </page>
                        
                        <page string="Status do Lead">
                            <group>
                                <field name="lead_created" widget="boolean_toggle"/>
                                <field name="lead_creation_date"/>
                                <field name="lead_id"/>
                            </group>
                        </page>
                    </notebook>
                    
                    <field name="notes" placeholder="Observações..."/>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- KANBAN VIEW                                  -->
    <!-- ============================================ -->
    <record id="view_crm_crosssell_opportunity_kanban" model="ir.ui.view">
        <field name="name">crm.crosssell.opportunity.kanban</field>
        <field name="model">crm.crosssell.opportunity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="opportunity_type">
                <field name="partner_id"/>
                <field name="opportunity_type"/>
                <field name="opportunity_score"/>
                <field name="current_aum"/>
                <field name="estimated_additional_revenue"/>
                <field name="status"/>
                <field name="lead_created"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_card_header">
                                    <strong><field name="partner_id"/></strong>
                                    <span class="badge badge-info float-end">
                                        <field name="status"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_card_body">
                                    <div>Score: <field name="opportunity_score"/>%</div>
                                    <div>AUM: <field name="current_aum" widget="monetary"/></div>
                                    <div>Receita Estimada: <field name="estimated_additional_revenue" widget="monetary"/>/ano</div>
                                </div>
                                <div class="oe_kanban_card_footer">
                                    <button name="action_create_crosssell_lead" type="object" 
                                            class="btn btn-sm btn-primary" 
                                            invisible="lead_created">
                                        Criar Lead
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- ACTIONS                                      -->
    <!-- ============================================ -->
    <record id="action_crm_crosssell_opportunity" model="ir.actions.act_window">
        <field name="name">Oportunidades de Cross-Sell</field>
        <field name="res_model">crm.crosssell.opportunity</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhuma oportunidade de cross-sell detectada
            </p>
            <p>
                Oportunidades são identificadas automaticamente baseadas em crescimento de AUM e divergências.
            </p>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- MENUS                                        -->
    <!-- ============================================ -->
    <menuitem id="menu_crm_crosssell"
              name="Cross-Sell"
              parent="crm.crm_menu_sales"
              action="action_crm_crosssell_opportunity"
              sequence="45"/>
    
</odoo>
