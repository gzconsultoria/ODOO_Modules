<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- APPROVAL: TREE VIEW                          -->
    <!-- ============================================ -->
    <record id="view_crm_approval_tree" model="ir.ui.view">
        <field name="name">crm.approval.tree</field>
        <field name="model">crm.approval</field>
        <field name="arch" type="xml">
            <list string="Aprovações CRM" default_order="request_date desc">
                <field name="request_date"/>
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="approval_type"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="priority" widget="priority"/>
                <field name="is_overdue" widget="boolean_toggle"/>
                <field name="deadline"/>
            </list>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- APPROVAL: FORM VIEW                          -->
    <!-- ============================================ -->
    <record id="view_crm_approval_form" model="ir.ui.view">
        <field name="name">crm.approval.form</field>
        <field name="model">crm.approval</field>
        <field name="arch" type="xml">
            <form string="Solicitação de Aprovação">
                <header>
                    <button name="action_submit_for_approval" string="Enviar para Aprovação" 
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Aprovar" 
                            type="object" class="btn-success"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" string="Rejeitar" 
                            type="object" class="btn-danger"
                            invisible="state != 'pending'"/>
                    <button name="action_cancel" string="Cancelar" 
                            type="object" class="btn-warning"
                            invisible="state in ['approved', 'rejected']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="approval_type" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="request_info">
                            <field name="lead_id"/>
                            <field name="partner_id"/>
                            <field name="request_date"/>
                            <field name="requested_by"/>
                        </group>
                        <group name="approval_info">
                            <field name="approver_id"/>
                            <field name="approval_date"/>
                            <field name="priority"/>
                            <field name="deadline"/>
                            <field name="is_overdue" widget="boolean_toggle"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Justificativa">
                            <field name="reason" placeholder="Explique o motivo da solicitação..."/>
                        </page>
                        
                        <page string="Valores" invisible="approval_type not in ['high_fee', 'large_deal']">
                            <group>
                                <group string="Fee" invisible="approval_type != 'high_fee'">
                                    <field name="proposed_fee" widget="percentage"/>
                                    <field name="standard_fee" widget="percentage"/>
                                </group>
                                <group string="Deal" invisible="approval_type != 'large_deal'">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="deal_value" widget="monetary"/>
                                    <field name="approval_threshold" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Decisão do Aprovador" invisible="state not in ['approved', 'rejected']">
                            <field name="approval_notes" placeholder="Comentários do aprovador..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- KANBAN VIEW                                  -->
    <!-- ============================================ -->
    <record id="view_crm_approval_kanban" model="ir.ui.view">
        <field name="name">crm.approval.kanban</field>
        <field name="model">crm.approval</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="lead_id"/>
                <field name="approval_type"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_card_header">
                                    <strong><field name="lead_id"/></strong>
                                    <span class="float-end">
                                        <field name="priority" widget="priority"/>
                                        <t t-if="record.is_overdue.raw_value">
                                            <span class="badge badge-danger">Atrasado</span>
                                        </t>
                                    </span>
                                </div>
                                <div class="oe_kanban_card_body">
                                    <div>Tipo: <field name="approval_type"/></div>
                                    <div>Solicitante: <field name="requested_by"/></div>
                                    <div>Aprovador: <field name="approver_id"/></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- ACTIONS                                      -->
    <!-- ============================================ -->
    <record id="action_crm_approval" model="ir.actions.act_window">
        <field name="name">Aprovações</field>
        <field name="res_model">crm.approval</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhuma solicitação de aprovação
            </p>
            <p>
                Solicitações de aprovação para fees especiais, deals grandes, etc.
            </p>
        </field>
    </record>
    
    <record id="action_crm_approval_pending" model="ir.actions.act_window">
        <field name="name">Minhas Aprovações Pendentes</field>
        <field name="res_model">crm.approval</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '=', 'pending'), ('approver_id', '=', uid)]</field>
        <field name="context">{}</field>
    </record>
    
    <!-- ============================================ -->
    <!-- MENUS                                        -->
    <!-- ============================================ -->
    <menuitem id="menu_crm_approval"
              name="Aprovações"
              parent="crm.crm_menu_config"
              action="action_crm_approval"
              sequence="90"/>
    
    <menuitem id="menu_crm_approval_pending"
              name="Pendentes para Mim"
              parent="menu_crm_approval"
              action="action_crm_approval_pending"
              sequence="5"/>
    
</odoo>
