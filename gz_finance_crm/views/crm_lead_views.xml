<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ====================================== -->
    <!-- CRM LEAD FORM VIEW INHERITANCE         -->
    <!-- ====================================== -->
    <record id="view_crm_lead_finance_form" model="ir.ui.view">
        <field name="name">crm.lead.finance.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Adicionar botão PERFIL FINANCEIRO no button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_finance_profile"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-user-circle"
                        groups="gz_finance_core.group_finance_user">
                    
                    <!-- Badge: Perfil Ativo (verde) -->
                    <div class="o_stat_info" invisible="not has_finance_profile">
                        <span class="o_stat_text text-success">
                            <i class="fa fa-check-circle"/> Perfil Ativo
                        </span>
                        <span class="o_stat_value">
                            <field name="finance_profile_id"/>
                        </span>
                    </div>
                    
                    <!-- Badge: Criar Perfil (cinza) -->
                    <div class="o_stat_info" invisible="has_finance_profile">
                        <span class="o_stat_text text-muted">
                            <i class="fa fa-plus-circle"/> CRIAR PERFIL FINANCEIRO
                        </span>
                    </div>
                    
                    <field name="has_finance_profile" invisible="1"/>
                </button>
            </xpath>
            
            <!-- Adicionar campos de qualificação financeira -->
            <xpath expr="//page[@name='extra']" position="before">
                
                <!-- ABA: QUALIFICAÇÃO FINANCEIRA -->
                <page string="Qualificação Financeira" name="finance_qualification">
                    
                    <group>
                        <group string="Estimativas Iniciais">
                            <field name="estimated_wealth" widget="monetary"/>
                            <field name="estimated_income_range"/>
                        </group>
                        <group string="Perfil e Urgência">
                            <field name="preliminary_risk_profile"/>
                            <field name="main_pain_point"/>
                            <field name="urgency_level"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Interesses">
                            <field name="investment_interest_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                        <group string="Score do Lead">
                            <field name="lead_score" widget="progressbar"/>
                            <field name="lead_temperature" widget="badge"
                                   decoration-danger="lead_temperature == 'hot'"
                                   decoration-warning="lead_temperature == 'warm'"
                                   decoration-info="lead_temperature == 'cold'"/>
                        </group>
                    </group>
                    
                    <separator string="Proposta Comercial"/>
                    <group>
                        <group>
                            <field name="proposal_sent_date"/>
                            <field name="proposed_fee" widget="percentage"/>
                        </group>
                        <group>
                            <field name="competitor_comparison" 
                                   placeholder="Ex: XP, BTG, Genial"/>
                        </group>
                    </group>
                    
                    <separator string="Objeções Levantadas"/>
                    <group>
                        <field name="objection_ids" widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create_edit': True}"
                               colspan="2" nolabel="1"/>
                    </group>
                    
                    <separator string="Notas sobre Objeções" invisible="not objection_ids"/>
                    <group invisible="not objection_ids">
                        <field name="objection_notes" widget="html" colspan="2" nolabel="1"
                               placeholder="Descreva como as objeções foram tratadas, argumentos utilizados, etc."/>
                    </group>
                    
                    <!-- Sprint 3: Alerta de Divergência AUM -->
                    <separator string="Divergência AUM" invisible="aum_divergence_alert == 'none'"/>
                    <group invisible="aum_divergence_alert == 'none'">
                        <group>
                            <field name="estimated_wealth" widget="monetary"/>
                            <field name="partner_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="aum_divergence" widget="percentage"/>
                            <field name="aum_divergence_alert" widget="badge"
                                   decoration-success="aum_divergence_alert == 'minor'"
                                   decoration-warning="aum_divergence_alert == 'moderate'"
                                   decoration-danger="aum_divergence_alert == 'critical'"/>
                        </group>
                    </group>
                    
                    <!-- NOVO: Widget de Divergências Completo -->
                    <separator string="⚠️ Análise de Divergências CRM ↔ Finance" 
                               invisible="not has_finance_profile or not has_data_divergence"/>
                    <group invisible="not has_finance_profile or not has_data_divergence">
                        <field name="has_data_divergence" invisible="1"/>
                        <field name="divergence_count" invisible="1"/>
                        
                        <group colspan="2">
                            <div class="alert alert-warning" role="alert">
                                <h4>
                                    <i class="fa fa-exclamation-triangle"/> 
                                    <field name="divergence_count"/> Divergências Detectadas
                                </h4>
                                <p>Os dados preliminares do CRM diferem dos dados definitivos no Finance Core.</p>
                            </div>
                        </group>
                        
                        <!-- Detalhes HTML -->
                        <group colspan="2">
                            <field name="divergence_details" widget="html" nolabel="1"/>
                        </group>
                        
                        <!-- Botões de Ação -->
                        <group colspan="2">
                            <div class="oe_button_box" style="margin-top: 10px;">
                                <button name="action_sync_from_finance" 
                                        type="object" 
                                        string="⬇️ Atualizar do Finance" 
                                        class="btn btn-primary"
                                        help="Sincronizar Finance → CRM (sobrescreve dados do CRM)"/>
                                <button name="action_sync_to_finance" 
                                        type="object" 
                                        string="⬆️ Enviar para Finance" 
                                        class="btn btn-success"
                                        help="Sincronizar CRM → Finance (sobrescreve dados do Finance)"/>
                            </div>
                        </group>
                        
                        <!-- Info de Última Sync -->
                        <group>
                            <field name="last_synced_at" readonly="1"/>
                            <field name="sync_source" readonly="1" widget="badge"
                                   decoration-info="sync_source == 'crm_to_finance'"
                                   decoration-success="sync_source == 'finance_to_crm'"
                                   decoration-warning="sync_source == 'manual'"/>
                        </group>
                    </group>
                    
                    <!-- Sprint 4: Google Calendar -->
                    <separator string="Reunião Google Meet" invisible="not meeting_link"/>
                    <group invisible="not meeting_link">
                        <group>
                            <field name="meeting_scheduled_date"/>
                            <field name="meeting_link" widget="url"/>
                        </group>
                        <group>
                            <field name="google_event_id" readonly="1"/>
                            <field name="auto_create_meeting" widget="boolean_toggle"/>
                        </group>
                    </group>
                    
                </page>
                
            </xpath>
            
        </field>
    </record>
    
</odoo>
