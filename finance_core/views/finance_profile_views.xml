<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_profile_list" model="ir.ui.view">
        <field name="name">finance.profile.list</field>
        <field name="model">finance.profile</field>
        <field name="arch" type="xml">
            <list decoration-danger="suitability_state == 'expired'" decoration-warning="suitability_state == 'expiring'">
                <field name="display_name"/>
                <field name="advisor_id"/>
                <field name="crm_lead_id"/>
                <field name="company_id"/>
                <field name="suitability_state"/>
                <field name="advisory_score"/>
                <field name="portfolio_value" widget="monetary"/>
                <field name="cashflow_balance" widget="monetary"/>
                <field name="pending_documents"/>
            </list>
        </field>
    </record>

    <record id="action_finance_profile" model="ir.actions.act_window">
        <field name="name">Perfis Financeiros</field>
        <field name="res_model">finance.profile</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'default_investor_type': 'pf'}</field>
    </record>

    <record id="action_finance_profile_dashboard" model="ir.actions.act_window">
        <field name="name">Painel Financeiro</field>
        <field name="res_model">finance.profile</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{}</field>
    </record>

    <record id="action_finance_alerts" model="ir.actions.act_window">
        <field name="name">Alertas de consultoria</field>
        <field name="res_model">finance.alert</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_finance_profile_form" model="ir.ui.view">
        <field name="name">finance.profile.form</field>
        <field name="model">finance.profile</field>
        <field name="arch" type="xml">
            <form string="Cliente 360°">
                <header>
                    <button name="action_open_onboarding_wizard" type="object" string="Atualizar onboarding" class="btn-secondary"/>
                    <button name="action_refresh_alerts" type="object" string="Atualizar alertas" class="btn-primary"/>
                    <button name="action_open_partner" type="object" string="Abrir contato" class="btn-light"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="crm_lead_id" string="Oportunidade CRM"/>
                        <h2>
                            <field name="crm_lead_id" placeholder="Selecione o Lead/Oportunidade no CRM..."/>
                        </h2>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_partner" class="oe_stat_button" icon="fa-user">
                            <field name="partner_id" widget="statinfo" string="Contato"/>
                        </button>
                        <button
                            class="oe_stat_button"
                            type="action"
                            name="%(finance_core.action_finance_alerts)d"
                            icon="fa-bell"
                            context="{'default_profile_id': id, 'search_default_profile_id': id}"
                            domain="[('profile_id', '=', id)]"
                        >
                            <field name="pending_documents" widget="statinfo" string="Alertas"/>
                        </button>
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_open_dashboard"
                            icon="fa-dashboard"
                        >
                            <span class="o_stat_text">Dashboard</span>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_goal_wizard" icon="fa-bullseye">
                            <span class="o_stat_text">Nova meta</span>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_review_wizard" icon="fa-calendar-check-o">
                            <span class="o_stat_text">Revisão trimestral</span>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_recommendation_wizard" icon="fa-lightbulb-o">
                            <span class="o_stat_text">Recomendação</span>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_schedule_review" icon="fa-video-camera">
                            <span class="o_stat_text">Agendar meet</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="advisor_id"/>
                            <field name="investor_type"/>
                            <field name="company_id"/>
                            <field name="partner_function"/>
                        </group>
                        <group>
                            <field name="suitability_profile"/>
                            <field name="suitability_score"/>
                            <field name="suitability_last_review"/>
                            <field name="suitability_next_review" readonly="1"/>
                            <field name="suitability_state" readonly="1"/>
                        </group>
                    </group>
                    <group col="4" class="o_finance_360_cards">
                        <div class="o_finance_card">
                            <label for="advisory_score" string="Score financeiro"/>
                            <field name="advisory_score" widget="percentpie"/>
                        </div>
                        <div class="o_finance_card">
                            <label for="portfolio_value" string="AUM consolidado"/>
                            <field name="portfolio_value" widget="monetary"/>
                        </div>
                        <div class="o_finance_card">
                            <label for="cashflow_balance" string="Fluxo de caixa mensal"/>
                            <field name="cashflow_balance" widget="monetary"/>
                        </div>
                        <div class="o_finance_card">
                            <label for="goals_progress_percentage" string="Progresso médio das metas"/>
                            <field name="goals_progress_percentage" widget="percentpie"/>
                        </div>
                    </group>
                    <notebook>
                        <page string="📋 Resumo">
                            <!-- Informações Financeiras Gerais -->
                            <group>
                                <group>
                                    <field name="annual_income"/>
                                    <field name="saving_capacity"/>
                                    <field name="emergency_fund_months"/>
                                </group>
                                <group>
                                    <field name="net_worth"/>
                                    <field name="compliance_status"/>
                                    <field name="risk_warnings" widget="html"/>
                                </group>
                            </group>
                            
                            <!-- Informações Pessoais e Notas -->
                            <separator string="👤 Informações Pessoais e Notas"/>
                            <group>
                                <group string="Cliente e Família">
                                    <field name="client_birthdate" readonly="1"/>
                                    <field name="marital_status" readonly="1"/>
                                    <field name="spouse_name" readonly="1" invisible="not spouse_name"/>
                                    <field name="spouse_birthdate" readonly="1" invisible="not spouse_birthdate"/>
                                    <field name="children_count" readonly="1"/>
                                    <field name="children_names" readonly="1" invisible="not children_names"/>
                                </group>
                                <group string="Interesses Pessoais">
                                    <field name="favorite_team" readonly="1"/>
                                    <field name="hobbies" widget="text" readonly="1" placeholder="Nenhum hobby cadastrado"/>
                                </group>
                            </group>
                            <group>
                                <field name="household_notes" widget="text" placeholder="Adicione observações sobre a família, preferências, contexto..."/>
                            </group>
                            
                            <!-- Objetivos do Cliente -->
                            <separator string="🎯 Objetivos do Cliente"/>
                            <group>
                                <group>
                                    <field name="short_term_goal" widget="text" readonly="1" placeholder="Nenhum objetivo de curto prazo definido"/>
                                    <field name="long_term_goal" widget="text" readonly="1" placeholder="Nenhum objetivo de longo prazo definido"/>
                                </group>
                                <group>
                                    <field name="main_goal" readonly="1"/>
                                    <field name="goal_amount" readonly="1" invisible="not goal_amount"/>
                                    <field name="goal_deadline_years" readonly="1" invisible="not goal_deadline_years"/>
                                    <field name="monthly_contribution_needed" readonly="1" invisible="not monthly_contribution_needed"/>
                                </group>
                            </group>
                            <group>
                                <field name="objective_summary" widget="text" placeholder="Resumo estratégico dos objetivos financeiros do cliente..."/>
                            </group>
                            
                            <!-- Tipo de Contrato e Valores -->
                            <separator string="💼 Tipo de Contrato"/>
                            <group>
                                <group>
                                    <field name="contract_type"/>
                                    <field name="proposal_amount" invisible="contract_type not in ['monthly', 'quarterly']"/>
                                    <field name="management_fee" widget="percentage" invisible="contract_type != 'aum_percentage'"/>
                                </group>
                                <group>
                                    <field name="estimated_annual_revenue" readonly="1" widget="monetary"/>
                                </group>
                            </group>
                            
                            <!-- Atividades e Tarefas -->
                            <group string="Atividades e tarefas">
                                <field name="activity_ids" widget="mail_activity"/>
                            </group>
                            
                            <!-- Privacidade e Segurança -->
                            <group string="🔐 Privacidade e Segurança">
                                <group>
                                    <field name="active" widget="boolean_toggle" readonly="not context.get('uid') == 1"/>
                                    <field name="privacy_deletion_requested" readonly="1"/>
                                    <field name="privacy_requested_date" readonly="1"/>
                                </group>
                                <group>
                                    <div class="alert alert-warning" role="alert" invisible="active">
                                        <p class="mb-0">
                                            <i class="fa fa-lock"/> 
                                            <strong>Perfil Desativado</strong><br/>
                                            Este perfil está em modo leitura (congelado).
                                        </p>
                                    </div>
                                </group>
                                <footer>
                                    <button name="action_toggle_active" 
                                            type="object" 
                                            string="🔓 Reativar Perfil" 
                                            class="btn-success" 
                                            icon="fa-unlock"
                                            invisible="active"
                                            groups="base.group_system,finance_core.group_finance_consultant"/>
                                    <button name="action_toggle_active" 
                                            type="object" 
                                            string="🔒 Desativar Perfil" 
                                            class="btn-warning" 
                                            icon="fa-lock"
                                            invisible="not active"
                                            groups="base.group_system,finance_core.group_finance_consultant"
                                            confirm="Desativar este perfil irá congelá-lo em modo leitura. Deseja continuar?"/>
                                    <button name="action_export_personal_data" 
                                            type="object" 
                                            string="📥 Exportar Dados" 
                                            class="btn-secondary" 
                                            icon="fa-download"/>
                                    <button name="action_request_data_deletion" 
                                            type="object" 
                                            string="📋 Registrar Solicitação LGPD" 
                                            class="btn-outline-primary" 
                                            icon="fa-shield"/>
                                    <button name="action_anonymize_partner" 
                                            type="object" 
                                            string="👤 Anonimizar Dados" 
                                            class="btn-light" 
                                            icon="fa-user-secret" 
                                            invisible="not privacy_deletion_requested"
                                            groups="base.group_system,finance_core.group_finance_consultant"/>
                                    <button name="action_secure_delete" 
                                            type="object" 
                                            string="🗑️ EXCLUIR PERMANENTEMENTE" 
                                            class="btn-danger" 
                                            icon="fa-trash"
                                            groups="base.group_system,finance_core.group_finance_consultant"/>
                                </footer>
                            </group>
                        </page>
                        
                        <!-- ABA: Alertas (2ª posição) -->
                        <page string="🔔 Alertas">
                            <field name="advisory_alert_ids">
                                <list editable="bottom">
                                    <field name="name" string="Nome"/>
                                    <field name="category" string="Categoria"/>
                                    <field name="trigger_date" string="Data"/>
                                    <field name="state" widget="statusbar" string="Estado"/>
                                    <field name="description" string="Descrição"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- ABA CONSOLIDADA: Informações Estratégicas -->
                        <page string="📊 Informações Estratégicas">
                            
                            <!-- Seção 1: Perfil do Cliente -->
                            <separator string="👤 Perfil e Contexto"/>
                            <group>
                                <group string="Informações Básicas">
                                    <field name="client_birthdate"/>
                                    <field name="marital_status"/>
                                    <field name="children_count"/>
                                    <field name="children_names" invisible="children_count == 0" placeholder="Ex: João (15), Maria (12)"/>
                                </group>
                                <group string="Cônjuge" invisible="marital_status != 'married'">
                                    <field name="spouse_name"/>
                                    <field name="spouse_birthdate"/>
                                </group>
                            </group>
                            <group>
                                <group string="Interesses Pessoais (Relacionamento)">
                                    <field name="favorite_team" placeholder="Ex: Corinthians"/>
                                    <field name="hobbies" widget="text" placeholder="Ex: Golfe, viagens internacionais, vinho..."/>
                                </group>
                                <group string="Qualificação Inicial">
                                    <field name="financial_readiness" placeholder="Ex: Iniciante, Intermediário, Experiente"/>
                                    <field name="primary_pain_point" placeholder="Qual é a principal dor/necessidade?"/>
                                </group>
                            </group>
                            
                            <!-- Seção 2: Objetivos (Meta Principal + Contexto) -->
                            <separator string="🎯 Meta Principal e Horizonte de Investimento"/>
                            <group>
                                <group>
                                    <field name="main_goal" placeholder="Ex: Aposentadoria, Compra de imóvel, Educação dos filhos"/>
                                    <field name="goal_amount" invisible="not main_goal"/>
                                    <field name="goal_deadline_years" invisible="not main_goal"/>
                                    <field name="monthly_contribution_needed" readonly="1" invisible="not goal_amount or not goal_deadline_years"/>
                                </group>
                                <group>
                                    <field name="short_term_goal" widget="text" placeholder="O que precisa acontecer nos próximos 12 meses?"/>
                                    <field name="investor_interests_ids" widget="many2many_tags" options="{'color_field': 'color'}" string="Produtos de Interesse"/>
                                </group>
                            </group>
                            
                            <!-- Seção 3: Diagnóstico Estratégico (SWOT Condensado) -->
                            <separator string="🔍 Diagnóstico Estratégico"/>
                            <group>
                                <field name="diagnosis_date" string="Data da Última Análise"/>
                            </group>
                            <group>
                                <group>
                                    <field name="diagnosis_current_situation" widget="text" string="Situação Atual" placeholder="Resumo executivo: patrimônio, fluxo de caixa, dívidas..."/>
                                    <field name="diagnosis_opportunities" widget="text" string="Principais Oportunidades" placeholder="O que pode ser feito para melhorar a situação?"/>
                                </group>
                                <group>
                                    <field name="diagnosis_strengths" widget="text" string="Pontos Fortes" placeholder="Ex: Alta renda, disciplina, diversificação..."/>
                                    <field name="diagnosis_weaknesses" widget="text" string="Riscos e Fraquezas" placeholder="Ex: Concentração em um ativo, falta de proteção, despesas altas..."/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- ABA: Proposta -->
                        <page string="💼 Proposta">
                            <group>
                                <group string="Plano Comercial">
                                    <field name="contract_plan"/>
                                    <field name="proposal_amount"/>
                                    <field name="contract_type"/>
                                    <field name="proposal_date"/>
                                </group>
                                <group string="💰 Precificação">
                                    <field name="management_fee" widget="percentage"/>
                                    <field name="estimated_annual_revenue" readonly="1" decoration-success="estimated_annual_revenue > 0"/>
                                    <p class="text-muted" invisible="not estimated_annual_revenue">
                                        Calculado automaticamente baseado no tipo de contrato
                                    </p>
                                </group>
                            </group>
                            <group>
                                <field name="proposal_justification" widget="text" placeholder="Explique o racional e valor da proposta..."/>
                            </group>
                            <separator string="Objeções e Tratativas"/>
                            <group>
                                <field name="proposal_objections_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': False}"/>
                            </group>
                        </page>
                        
                        <!-- ABA: Reunião Estratégica -->
                        <page string="💡 Reunião Estratégica">
                            <group>
                                <group string="Informações da Reunião">
                                    <field name="meeting_date"/>
                                    <field name="meeting_strategies_discussed" widget="text" placeholder="Resumo das estratégias discutidas na reunião..."/>
                                    <field name="meeting_objections" widget="text" placeholder="Principais objeções ou dúvidas levantadas..."/>
                                </group>
                                <group string="Estratégia e Avaliação">
                                    <field name="recommended_strategies_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': False}"/>
                                </group>
                            </group>
                            <separator string="Agendamento"/>
                            <group>
                                <group>
                                    <field name="last_meeting_id"/>
                                    <field name="days_since_last_meeting" widget="integer"/>
                                </group>
                                <group>
                                    <field name="next_meeting_id"/>
                                    <field name="event_count" widget="integer"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- ABA: Onboarding -->
                        <page string="📝 Onboarding">
                            <group string="Processo de Onboarding">
                                <p class="text-muted">
                                    Esta aba será expandida com campos específicos do processo de onboarding:
                                    documentação entregue, corretoras abertas, assinaturas de contratos, etc.
                                </p>
                                <group>
                                    <field name="suitability_score"/>
                                    <field name="suitability_profile"/>
                                    <field name="suitability_last_review"/>
                                    <field name="compliance_status"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- ABA: Execução & Acompanhamento -->
                        <page string="📈 Execução &amp; Acompanhamento">
                            <group string="Acompanhamento Contínuo">
                                <p class="text-muted">
                                    Esta aba será expandida com dados de acompanhamento mensal:
                                    reuniões de review, evolução de portfólio, ações tomadas, etc.
                                </p>
                                <group>
                                    <field name="portfolio_value"/>
                                    <field name="cashflow_balance"/>
                                    <field name="goals_progress_percentage"/>
                                    <field name="advisory_score"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View: finance.profile -->
    <record id="view_finance_profile_search" model="ir.ui.view">
        <field name="name">finance.profile.search</field>
        <field name="model">finance.profile</field>
        <field name="arch" type="xml">
            <search string="Buscar Perfil">
                <field name="partner_id"/>
                <field name="advisor_id"/>
                <separator/>
                <filter string="Meus Clientes" name="filter_my_clients" domain="[('advisor_id', '=', uid)]"/>
                <filter string="Pessoa Física" name="filter_pf" domain="[('investor_type', '=', 'pf')]"/>
                <filter string="Pessoa Jurídica" name="filter_pj" domain="[('investor_type', '=', 'pj')]"/>
                <separator/>
                <filter string="Suitability Expirado" name="filter_expired" domain="[('suitability_state', '=', 'expired')]"/>
                <group name="group_by">
                    <filter name="group_advisor" string="Consultor" domain="[]" context="{'group_by': 'advisor_id'}"/>
                    <filter name="group_lead" string="Lead CRM" context="{'group_by': 'crm_lead_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Search View: finance.alert -->
    <record id="view_finance_alert_search" model="ir.ui.view">
        <field name="name">finance.alert.search</field>
        <field name="model">finance.alert</field>
        <field name="arch" type="xml">
            <search string="Buscar Alerta">
                <field name="name"/>
                <field name="profile_id"/>
                <separator/>
                <filter string="Aberto" name="filter_pending" domain="[('state', '=', 'open')]"/>
                <filter string="Em Andamento" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <group name="group_by">
                    <filter name="group_state" string="Estado" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_category" string="Categoria" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_finance_root" name="Consultoria Financeira" sequence="10" groups="finance_core.group_finance_consultant"/>
    <menuitem id="menu_finance_profiles" parent="menu_finance_root" name="Clientes" action="action_finance_profile" sequence="10"/>
    <menuitem id="menu_finance_alerts" parent="menu_finance_root" name="Alertas" action="action_finance_alerts" sequence="20" groups="finance_core.group_finance_consultant,finance_core.group_finance_compliance"/>
</odoo>
