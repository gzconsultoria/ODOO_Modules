<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- CRON: Atualiza referências de reuniões (última e próxima) diariamente -->
        <record id="ir_cron_update_meeting_references" model="ir.cron">
            <field name="name">Finance: Atualizar Referências de Reuniões</field>
            <field name="model_id" ref="model_finance_profile"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_meeting_references()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
