<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tags de Estratégias de Investimento -->
        
        <record id="strategy_fixed_income" model="finance.strategy.tag">
            <field name="name">Renda Fixa</field>
            <field name="color">1</field>
            <field name="description">Estratégia focada em títulos de renda fixa (CDBs, LCIs, LCAs, Debêntures)</field>
        </record>
        
        <record id="strategy_tesouro" model="finance.strategy.tag">
            <field name="name">Tesouro Direto</field>
            <field name="color">2</field>
            <field name="description">Investimentos em títulos públicos federais</field>
        </record>
        
        <record id="strategy_fiis" model="finance.strategy.tag">
            <field name="name">Fundos Imobiliários (FIIs)</field>
            <field name="color">3</field>
            <field name="description">Carteira de fundos imobiliários para renda passiva</field>
        </record>
        
        <record id="strategy_etfs" model="finance.strategy.tag">
            <field name="name">ETFs</field>
            <field name="color">4</field>
            <field name="description">Fundos de índice para diversificação e baixo custo</field>
        </record>
        
        <record id="strategy_stocks" model="finance.strategy.tag">
            <field name="name">Ações</field>
            <field name="color">5</field>
            <field name="description">Portfólio de ações com foco em dividendos e crescimento</field>
        </record>
        
        <record id="strategy_retirement" model="finance.strategy.tag">
            <field name="name">Previdência Privada</field>
            <field name="color">6</field>
            <field name="description">Planejamento previdenciário (PGBL/VGBL)</field>
        </record>
        
        <record id="strategy_protection" model="finance.strategy.tag">
            <field name="name">Proteção e Seguros</field>
            <field name="color">7</field>
            <field name="description">Seguros de vida, invalidez e proteção patrimonial</field>
        </record>
        
        <record id="strategy_international" model="finance.strategy.tag">
            <field name="name">Investimentos Internacionais</field>
            <field name="color">8</field>
            <field name="description">Diversificação internacional (ETFs globais, BDRs)</field>
        </record>
        
        <record id="strategy_emergency_fund" model="finance.strategy.tag">
            <field name="name">Reserva de Emergência</field>
            <field name="color">9</field>
            <field name="description">Construção ou ajuste da reserva de emergência</field>
        </record>
        
        <record id="strategy_debt_payoff" model="finance.strategy.tag">
            <field name="name">Quitação de Dívidas</field>
            <field name="color">10</field>
            <field name="description">Estratégia para eliminar dívidas de alto custo</field>
        </record>
        
        <record id="strategy_diversification" model="finance.strategy.tag">
            <field name="name">Diversificação</field>
            <field name="color">11</field>
            <field name="description">Ajuste de alocação para melhor diversificação de risco</field>
        </record>
        
    </data>
</odoo>
