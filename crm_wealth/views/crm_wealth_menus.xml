<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- =============================================== -->
    <!-- ACTIONS para modelos auxiliares                -->
    <!-- =============================================== -->
    
    <record id="action_crm_wealth_interesse" model="ir.actions.act_window">
        <field name="name">Interesses</field>
        <field name="res_model">crm.wealth.interesse</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar primeiro interesse
            </p>
            <p>
                Defina os interesses que podem ser selecionados na aba Captação
            </p>
        </field>
    </record>
    
    <record id="action_crm_wealth_estrategia" model="ir.actions.act_window">
        <field name="name">Estratégias</field>
        <field name="res_model">crm.wealth.estrategia</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar primeira estratégia
            </p>
            <p>
                Defina as estratégias de investimento disponíveis
            </p>
        </field>
    </record>
    
    <record id="action_crm_wealth_objecao" model="ir.actions.act_window">
        <field name="name">Objeções</field>
        <field name="res_model">crm.wealth.objecao</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar primeira objeção
            </p>
            <p>
                Cadastre objeções comuns e suas tratativas padrão
            </p>
        </field>
    </record>
    
    <record id="action_crm_wealth_documento" model="ir.actions.act_window">
        <field name="name">Documentos</field>
        <field name="res_model">crm.wealth.documento</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar primeiro tipo de documento
            </p>
            <p>
                Defina os documentos necessários para onboarding
            </p>
        </field>
    </record>
    
    <record id="action_crm_wealth_corretora" model="ir.actions.act_window">
        <field name="name">Corretoras</field>
        <field name="res_model">crm.wealth.corretora</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar primeira corretora
            </p>
            <p>
                Cadastre as corretoras parceiras
            </p>
        </field>
    </record>
    
    <record id="action_crm_wealth_acompanhamento" model="ir.actions.act_window">
        <field name="name">Acompanhamentos</field>
        <field name="res_model">crm.wealth.acompanhamento</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhum acompanhamento registrado
            </p>
            <p>
                Os acompanhamentos mensais são criados nas oportunidades
            </p>
        </field>
    </record>
    
    <!-- =============================================== -->
    <!-- MENU TÉCNICO: Wealth Management                 -->
    <!-- Acessível apenas em modo desenvolvedor          -->
    <!-- =============================================== -->
    
    <menuitem 
        id="menu_crm_wealth_root"
        name="Wealth Management"
        parent="base.menu_custom"
        sequence="100"
        groups="base.group_no_one"/>
    
    <!-- Submenus de Configuração Técnica -->
    <menuitem 
        id="menu_crm_wealth_interesse"
        name="Interesses"
        parent="menu_crm_wealth_root"
        action="action_crm_wealth_interesse"
        sequence="10"
        groups="base.group_no_one"/>
    
    <menuitem 
        id="menu_crm_wealth_estrategia"
        name="Estratégias"
        parent="menu_crm_wealth_root"
        action="action_crm_wealth_estrategia"
        sequence="20"
        groups="base.group_no_one"/>
    
    <menuitem 
        id="menu_crm_wealth_objecao"
        name="Objeções"
        parent="menu_crm_wealth_root"
        action="action_crm_wealth_objecao"
        sequence="30"
        groups="base.group_no_one"/>
    
    <menuitem 
        id="menu_crm_wealth_documento"
        name="Documentos"
        parent="menu_crm_wealth_root"
        action="action_crm_wealth_documento"
        sequence="40"
        groups="base.group_no_one"/>
    
    <menuitem 
        id="menu_crm_wealth_corretora"
        name="Corretoras"
        parent="menu_crm_wealth_root"
        action="action_crm_wealth_corretora"
        sequence="50"
        groups="base.group_no_one"/>
    
    <!-- Menu para Configurações de Taxas e SLAs -->
    <record id="action_crm_wealth_settings" model="ir.actions.act_window">
        <field name="name">Taxas e SLAs</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'crm'}</field>
    </record>
    
    <menuitem 
        id="menu_crm_wealth_settings"
        name="Taxas e SLAs"
        parent="menu_crm_wealth_root"
        action="action_crm_wealth_settings"
        sequence="1"
        groups="base.group_no_one"/>
    
</odoo>
