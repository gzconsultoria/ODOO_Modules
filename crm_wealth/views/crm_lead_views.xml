<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================================ -->
    <!-- ADICIONA CAMPOS PESSOAIS NA ABA "CONTATO" PADRÃO DO CRM -->
    <!-- ============================================================ -->
    
    <record id="crm_lead_view_form_add_personal_info" model="ir.ui.view">
        <field name="name">crm.lead.form.personal.info</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Adiciona seção "Informações Pessoais" após o grupo Misc na aba lead -->
            <xpath expr="//page[@name='lead']//group[@name='Misc']" position="after">
                <group string="👤 Informações Pessoais" name="personal_info" col="2">
                    <group>
                        <field name="data_aniversario_cliente"/>
                        <field name="estado_civil"/>
                        <field name="nome_conjuge" 
                               invisible="estado_civil != 'casado'"
                               required="estado_civil == 'casado'"/>
                        <field name="data_aniversario_conjuge"
                               invisible="estado_civil != 'casado'"/>
                    </group>
                    <group>
                        <field name="quantidade_filhos"/>
                        <field name="nomes_filhos" 
                               invisible="quantidade_filhos == 0"/>
                        <field name="time_coracao"/>
                        <field name="hobbies"/>
                    </group>
                </group>
            </xpath>
            
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- FORMULÁRIO HERDADO DO CRM.LEAD COM ABAS DINÂMICAS -->
    <!-- ============================================================ -->
    
    <record id="crm_lead_view_form_wealth" model="ir.ui.view">
        <field name="name">crm.lead.form.wealth</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Adiciona as abas personalizadas dentro do notebook existente -->
            <xpath expr="//notebook" position="inside">
                
                <!-- ============================================================ -->
                <!-- ABA 0: RESUMO EXECUTIVO (Sempre primeira - sequence 0) -->
                <!-- ============================================================ -->
                <page string="📊 Resumo" 
                      name="resumo" 
                      sequence="0">
                    
                    <!-- Hero Card - Contexto Executivo -->
                    <group>
                        <group string="💰 Contexto Financeiro">
                            <field name="valor_investido_atual" readonly="1"/>
                            <field name="valor_objetivo" readonly="1"/>
                            <field name="prazo_objetivo" readonly="1"/>
                            <field name="perfil_investidor" readonly="1"/>
                        </group>
                        <group string="📊 Indicadores">
                            <field name="score_qualificacao" readonly="1"/>
                            <field name="lead_temperature" readonly="1"/>
                            <field name="receita_anual_estimada" readonly="1"/>
                            <field name="aporte_mensal_necessario" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Card de Perfil Pessoal -->
                    <group string="👤 Perfil Pessoal">
                        <field name="perfil_pessoal_resumo" nolabel="1" colspan="2"/>
                    </group>
                    
                    <!-- Próximas Tarefas -->
                    <group string="📌 Próximas Tarefas">
                        <field name="activity_ids" nolabel="1" colspan="2"/>
                    </group>
                    
                    <!-- Alertas e Lembretes -->
                    <group string="⚠️ Alertas &amp; Lembretes">
                        <field name="alertas_resumo" nolabel="1" colspan="2"/>
                    </group>
                    
                </page>
                
                <!-- ============================================================ -->
                <!-- ABA 1: CAPTAÇÃO -->
                <!-- ============================================================ -->
                <page string="🔵 Captação" 
                      name="captacao" 
                      invisible="not show_captacao">
                    <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                        <strong>✅ Completude desta aba:</strong> <field name="captacao_completude" readonly="1" nolabel="1"/>%
                    </div>
                    <group>
                        <group string="Informações de Origem">
                            <field name="show_captacao" invisible="1"/>
                            <field name="captacao_completude" invisible="1"/>
                            <field name="momento_financeiro"/>
                        </group>
                        <group string="Perfil Financeiro Inicial">
                            <field name="patrimonio_aproximado"/>
                            <field name="renda_mensal"/>
                        </group>
                    </group>
                    <group string="Interesses Iniciais">
                        <field name="interesse_inicial" widget="many2many_tags" options="{'color_field': 'name', 'no_create': False}"/>
                    </group>
                </page>

                <!-- ============================================================ -->
                <!-- ABA 2: QUALIFICAÇÃO -->
                <!-- ============================================================ -->
                <page string="🟢 Qualificação" 
                      name="qualificacao" 
                      invisible="not show_qualificacao">
                    <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                        <strong>✅ Completude desta aba:</strong> <field name="qualificacao_completude" readonly="1" nolabel="1"/>%
                    </div>
                    <group>
                        <group string="Perfil e Dores">
                            <field name="show_qualificacao" invisible="1"/>
                            <field name="qualificacao_completude" invisible="1"/>
                            <field name="perfil_investidor"/>
                            <field name="dor_principal" widget="radio"/>
                        </group>
                        <group string="Objetivos">
                            <field name="objetivo_curto_prazo" placeholder="Ex.: investir melhor, sair do zero, quitar dívidas"/>
                            <field name="objetivo_longo_prazo" placeholder="Ex.: FIRE, comprar imóvel, aposentadoria, independência financeira"/>
                        </group>
                    </group>
                    <group>
                        <group string="Objetivo Financeiro Principal">
                            <field name="objetivo_principal"/>
                            <field name="valor_objetivo"/>
                            <field name="prazo_objetivo" widget="integer"/>
                        </group>
                        <group string="📊 Cálculo Automático">
                            <field name="aporte_mensal_necessario" readonly="1" 
                                   decoration-success="aporte_mensal_necessario > 0"
                                   widget="monetary"/>
                            <p class="text-muted" invisible="not aporte_mensal_necessario">
                                💡 Baseado na taxa configurada em: Configurações → CRM → Wealth Management<br/>
                                Cálculo: PMT com juros compostos para atingir o objetivo no prazo
                            </p>
                        </group>
                    </group>
                </page>

                <!-- ============================================================ -->
                <!-- ABA 3: REUNIÃO ESTRATÉGICA -->
                <!-- ============================================================ -->
                <page string="🟣 Reunião Estratégica" 
                      name="reuniao_estrategica" 
                      invisible="not show_reuniao">
                    <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                        <strong>✅ Completude desta aba:</strong> <field name="reuniao_completude" readonly="1" nolabel="1"/>%
                    </div>
                    <group>
                        <group string="Informações da Reunião">
                            <field name="show_reuniao" invisible="1"/>
                            <field name="reuniao_completude" invisible="1"/>
                            <field name="data_reuniao"/>
                            <field name="estrategias_discutidas" placeholder="Resumo das estratégias discutidas"/>
                            <field name="objecoes_identificadas" placeholder="Principais objeções ou dúvidas"/>
                        </group>
                        <group string="Estratégia e Avaliação">
                            <field name="estrategias_recomendadas" widget="many2many_tags" options="{'color_field': 'name', 'no_create': False}"/>
                            <field name="score_potencial" widget="radio"/>
                        </group>
                    </group>
                    <group>
                        <group string="Diagnóstico Inicial">
                            <field name="diagnostico_situacao_atual" placeholder="Descrição da situação financeira atual do cliente"/>
                            <field name="diagnostico_pontos_fortes" placeholder="O que o cliente já faz bem"/>
                            <field name="diagnostico_pontos_melhorar" placeholder="Áreas que precisam de atenção"/>
                            <field name="diagnostico_oportunidades" placeholder="Oportunidades identificadas"/>
                        </group>
                    </group>
                </page>

                <!-- ============================================================ -->
                <!-- ABA 4: PROPOSTA -->
                <!-- ============================================================ -->
                <page string="🟠 Proposta" 
                      name="proposta" 
                      invisible="not show_proposta">
                    <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                        <strong>✅ Completude desta aba:</strong> <field name="proposta_completude" readonly="1" nolabel="1"/>%
                    </div>
                    <group>
                        <group string="Detalhes da Proposta">
                            <field name="show_proposta" invisible="1"/>
                            <field name="proposta_completude" invisible="1"/>
                            <field name="plano_contratado"/>
                            <field name="valor_proposta"/>
                            <field name="fee_gestao" widget="percentage"/>
                            <field name="tipo_contrato"/>
                            <field name="justificativa_valor" placeholder="Explique o racional e valor da proposta"/>
                        </group>
                        <group string="💰 Receita Estimada">
                            <field name="receita_anual_estimada" readonly="1" 
                                   decoration-success="receita_anual_estimada > 0"
                                   widget="monetary"/>
                            <p class="text-muted" invisible="not receita_anual_estimada">
                                Calculado como: Valor da Proposta × Fee de Gestão
                            </p>
                        </group>
                    </group>
                    <group>
                        <group string="Objeções e Tratativas">
                            <field name="objecoes_apresentadas" widget="many2many_tags" options="{'color_field': 'name', 'no_create': False}"/>
                        </group>
                    </group>
                </page>

                <!-- ============================================================ -->
                <!-- ABA 5: ONBOARDING -->
                <!-- ============================================================ -->
                <page string="🟡 Onboarding" 
                      name="onboarding" 
                      invisible="not show_onboarding">
                    <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                        <strong>✅ Completude desta aba:</strong> <field name="onboarding_completude" readonly="1" nolabel="1"/>%
                    </div>
                    <group>
                        <group string="Documentação e Compliance">
                            <field name="show_onboarding" invisible="1"/>
                            <field name="onboarding_completude" invisible="1"/>
                            <field name="suitability_oficial"/>
                            <field name="perfil_risco_final"/>
                            <field name="estrutura_inicial_montada"/>
                        </group>
                        <group string="Estrutura Operacional">
                            <field name="documentos_entregues" widget="many2many_tags" options="{'no_create': False}"/>
                            <field name="contas_corretoras" widget="many2many_tags" options="{'no_create': False}"/>
                        </group>
                    </group>
                </page>

                <!-- ============================================================ -->
                <!-- ABA 6: EXECUÇÃO & ACOMPANHAMENTO -->
                <!-- ============================================================ -->
                <page string="🟤 Execução &amp; Acompanhamento" 
                      name="execucao" 
                      invisible="not show_execucao">
                    <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                        <strong>✅ Completude desta aba:</strong> <field name="execucao_completude" readonly="1" nolabel="1"/>%
                    </div>
                    <group>
                        <group string="Portfólio Atual">
                            <field name="show_execucao" invisible="1"/>
                            <field name="execucao_completude" invisible="1"/>
                            <field name="valor_investido_atual"/>
                            <field name="distribuicao_portfolio" placeholder="Ex.: 60% Renda Fixa, 30% Ações, 10% FIIs"/>
                            <field name="historico_mudancas" placeholder="Registro de mudanças realizadas"/>
                        </group>
                    </group>
                    
                    <group string="Acompanhamento Mensal">
                        <field name="acompanhamento_mensal_ids" nolabel="1"/>
                    </group>
                </page>
                
            </xpath>
            
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- VIEWS PARA ACOMPANHAMENTO MENSAL -->
    <!-- ============================================================ -->
    
    <record id="crm_wealth_acompanhamento_view_tree" model="ir.ui.view">
        <field name="name">crm.wealth.acompanhamento.tree</field>
        <field name="model">crm.wealth.acompanhamento</field>
        <field name="arch" type="xml">
            <list>
                <field name="data_reuniao"/>
                <field name="name"/>
                <field name="valor_portfolio"/>
                <field name="rentabilidade_periodo"/>
                <field name="satisfacao_cliente"/>
            </list>
        </field>
    </record>

    <record id="crm_wealth_acompanhamento_view_form" model="ir.ui.view">
        <field name="name">crm.wealth.acompanhamento.form</field>
        <field name="model">crm.wealth.acompanhamento</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="data_reuniao"/>
                            <field name="valor_portfolio"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="rentabilidade_periodo"/>
                            <field name="satisfacao_cliente"/>
                        </group>
                    </group>
                    <group>
                        <field name="mudancas_realizadas" placeholder="Rebalanceamento, novos aportes, mudança de estratégia"/>
                        <field name="proximos_passos"/>
                        <field name="observacoes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- VIEWS TREE PARA MODELOS AUXILIARES -->
    <!-- ============================================================ -->

    <!-- Interesses -->
    <record id="crm_wealth_interesse_view_tree" model="ir.ui.view">
        <field name="name">crm.wealth.interesse.tree</field>
        <field name="model">crm.wealth.interesse</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Estratégias -->
    <record id="crm_wealth_estrategia_view_tree" model="ir.ui.view">
        <field name="name">crm.wealth.estrategia.tree</field>
        <field name="model">crm.wealth.estrategia</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="descricao"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Objeções -->
    <record id="crm_wealth_objecao_view_tree" model="ir.ui.view">
        <field name="name">crm.wealth.objecao.tree</field>
        <field name="model">crm.wealth.objecao</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="tratativa_padrao"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Documentos -->
    <record id="crm_wealth_documento_view_tree" model="ir.ui.view">
        <field name="name">crm.wealth.documento.tree</field>
        <field name="model">crm.wealth.documento</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="obrigatorio"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Corretoras -->
    <record id="crm_wealth_corretora_view_tree" model="ir.ui.view">
        <field name="name">crm.wealth.corretora.tree</field>
        <field name="model">crm.wealth.corretora</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

</odoo>
