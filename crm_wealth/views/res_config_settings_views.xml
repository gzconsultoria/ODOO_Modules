<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================================ -->
    <!-- CONFIGURAÇÕES DO MÓDULO WEALTH MANAGEMENT -->
    <!-- ============================================================ -->
    
    <record id="res_config_settings_view_form_wealth" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.wealth</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Adiciona seção Wealth Management após outras configurações do CRM -->
            <xpath expr="//app[@name='crm']//block[@name='generate_lead_setting_container']" position="after">
                
                <block title="Wealth Management" name="wealth_management_settings">
                    
                    <setting string="📊 Taxas de Retorno">
                        <div class="text-muted mb-3">
                            Configure as taxas usadas nos cálculos de aporte mensal necessário
                        </div>
                        <div class="content-group">
                            <div class="row">
                                <label string="Taxa Padrão (% a.a.)" for="wealth_taxa_padrao" class="col-lg-3 o_light_label"/>
                                <field name="wealth_taxa_padrao"/>
                            </div>
                            <div class="row">
                                <label string="Taxa Conservadora" for="wealth_taxa_conservadora" class="col-lg-3 o_light_label"/>
                                <field name="wealth_taxa_conservadora"/>
                            </div>
                            <div class="row">
                                <label string="Taxa Moderada" for="wealth_taxa_moderada" class="col-lg-3 o_light_label"/>
                                <field name="wealth_taxa_moderada"/>
                            </div>
                            <div class="row">
                                <label string="Taxa Agressiva" for="wealth_taxa_agressiva" class="col-lg-3 o_light_label"/>
                                <field name="wealth_taxa_agressiva"/>
                            </div>
                        </div>
                    </setting>
                    
                    <setting string="⏱️ SLAs e Notificações Automáticas">
                        <div class="text-muted mb-3">
                            Configure os prazos para alertas automáticos de follow-up. O sistema vai criar atividades e notificações quando os prazos forem ultrapassados.
                        </div>
                        <div class="content-group">
                            <div class="row mt-3 mb-3">
                                <label string="Habilitar SLAs" for="wealth_sla_enabled" class="col-lg-3 o_light_label"/>
                                <field name="wealth_sla_enabled" widget="boolean_toggle"/>
                            </div>
                            <div class="row">
                                <label string="SLA Captação (dias)" for="wealth_sla_captacao" class="col-lg-3 o_light_label"/>
                                <field name="wealth_sla_captacao"/>
                                <span class="text-muted ml-2">Alerta se lead ficar parado em Captação</span>
                            </div>
                            <div class="row">
                                <label string="SLA Qualificação (dias)" for="wealth_sla_qualificacao" class="col-lg-3 o_light_label"/>
                                <field name="wealth_sla_qualificacao"/>
                                <span class="text-muted ml-2">Alerta se qualificação demorar muito</span>
                            </div>
                            <div class="row">
                                <label string="SLA Pós-Reunião (dias)" for="wealth_sla_reuniao" class="col-lg-3 o_light_label"/>
                                <field name="wealth_sla_reuniao"/>
                                <span class="text-muted ml-2">Alerta se não houver follow-up após reunião</span>
                            </div>
                            <div class="row">
                                <label string="SLA Proposta (dias)" for="wealth_sla_proposta" class="col-lg-3 o_light_label"/>
                                <field name="wealth_sla_proposta"/>
                                <span class="text-muted ml-2">Alerta se proposta ficar sem resposta</span>
                            </div>
                            <div class="row">
                                <label string="SLA Onboarding (dias)" for="wealth_sla_onboarding" class="col-lg-3 o_light_label"/>
                                <field name="wealth_sla_onboarding"/>
                                <span class="text-muted ml-2">Alerta se onboarding atrasar</span>
                            </div>
                        </div>
                        <div class="alert alert-info mt-3" role="alert">
                            <strong>💡 Como funciona:</strong><br/>
                            • O sistema verifica diariamente às 9h os leads em cada estágio<br/>
                            • Cria atividades automáticas para o vendedor responsável<br/>
                            • Envia notificações no inbox do Odoo<br/>
                            • Não cria duplicatas se já existir atividade similar aberta
                        </div>
                    </setting>
                    
                </block>
                
            </xpath>
            
        </field>
    </record>
    
</odoo>
