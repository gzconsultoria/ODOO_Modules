<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- ATUALIZA ESTÁGIOS PADRÃO DO CRM PARA WEALTH MANAGEMENT -->
        <!-- Reutiliza os stages existentes do módulo CRM ao invés de criar duplicatas -->
        <!-- ============================================================ -->
        
        <!-- Stage 1: Novo Lead -> Captação -->
        <record id="crm.stage_lead1" model="crm.stage">
            <field name="name">🔵 Captação</field>
            <field name="sequence">10</field>
        </record>

        <!-- Stage 2: Qualificado -> Qualificação -->
        <record id="crm.stage_lead2" model="crm.stage">
            <field name="name">🟢 Qualificação</field>
            <field name="sequence">20</field>
        </record>

        <!-- Stage 3: Proposta -> Reunião Estratégica -->
        <record id="crm.stage_lead3" model="crm.stage">
            <field name="name">🟣 Reunião Estratégica</field>
            <field name="sequence">30</field>
        </record>

        <!-- Stage 4: Negociação -> Proposta -->
        <record id="crm.stage_lead4" model="crm.stage">
            <field name="name">🟠 Proposta</field>
            <field name="sequence">40</field>
        </record>

        <!-- Stage 5: Novo estágio Onboarding -->
        <record id="stage_onboarding" model="crm.stage">
            <field name="name">🟡 Onboarding</field>
            <field name="sequence">50</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
        </record>

        <!-- Stage 6: Novo estágio Execução & Acompanhamento (Ganho) -->
        <record id="stage_execucao" model="crm.stage">
            <field name="name">🟤 Execução &amp; Acompanhamento</field>
            <field name="sequence">60</field>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- INTERESSES INICIAIS (DADOS EXEMPLO) -->
        <!-- ============================================================ -->

        <record id="interesse_bolsa" model="crm.wealth.interesse">
            <field name="name">Bolsa de Valores</field>
        </record>

        <record id="interesse_fiis" model="crm.wealth.interesse">
            <field name="name">Fundos Imobiliários (FIIs)</field>
        </record>

        <record id="interesse_previdencia" model="crm.wealth.interesse">
            <field name="name">Previdência Privada</field>
        </record>

        <record id="interesse_renda_fixa" model="crm.wealth.interesse">
            <field name="name">Renda Fixa</field>
        </record>

        <record id="interesse_planejamento" model="crm.wealth.interesse">
            <field name="name">Planejamento Financeiro</field>
        </record>

        <record id="interesse_gestao" model="crm.wealth.interesse">
            <field name="name">Gestão de Patrimônio</field>
        </record>

        <record id="interesse_mentoria" model="crm.wealth.interesse">
            <field name="name">Mentoria Financeira</field>
        </record>

        <record id="interesse_fire" model="crm.wealth.interesse">
            <field name="name">FIRE (Independência Financeira)</field>
        </record>

        <record id="interesse_criptomoedas" model="crm.wealth.interesse">
            <field name="name">Criptomoedas</field>
        </record>

        <record id="interesse_acoes_internacionais" model="crm.wealth.interesse">
            <field name="name">Ações Internacionais</field>
        </record>

        <!-- ============================================================ -->
        <!-- ESTRATÉGIAS DE INVESTIMENTO -->
        <!-- ============================================================ -->

        <record id="estrategia_renda_fixa" model="crm.wealth.estrategia">
            <field name="name">Renda Fixa</field>
            <field name="descricao">CDB, LCI, LCA, Tesouro Direto</field>
        </record>

        <record id="estrategia_tesouro" model="crm.wealth.estrategia">
            <field name="name">Tesouro Direto</field>
            <field name="descricao">Selic, IPCA+, Prefixado</field>
        </record>

        <record id="estrategia_fiis" model="crm.wealth.estrategia">
            <field name="name">Fundos Imobiliários</field>
            <field name="descricao">FIIs de tijolo, papel e híbridos</field>
        </record>

        <record id="estrategia_acoes" model="crm.wealth.estrategia">
            <field name="name">Ações</field>
            <field name="descricao">Ações nacionais e dividendos</field>
        </record>

        <record id="estrategia_etfs" model="crm.wealth.estrategia">
            <field name="name">ETFs</field>
            <field name="descricao">ETFs nacionais e internacionais</field>
        </record>

        <record id="estrategia_previdencia" model="crm.wealth.estrategia">
            <field name="name">Previdência Privada</field>
            <field name="descricao">PGBL, VGBL</field>
        </record>

        <record id="estrategia_protecao" model="crm.wealth.estrategia">
            <field name="name">Proteção Patrimonial</field>
            <field name="descricao">Seguros de vida, invalidez e holding</field>
        </record>

        <record id="estrategia_internacional" model="crm.wealth.estrategia">
            <field name="name">Investimentos Internacionais</field>
            <field name="descricao">Stocks, REITs, Bonds</field>
        </record>

        <!-- ============================================================ -->
        <!-- OBJEÇÕES COMUNS -->
        <!-- ============================================================ -->

        <record id="objecao_preco" model="crm.wealth.objecao">
            <field name="name">Preço Alto</field>
            <field name="tratativa_padrao">Mostrar ROI e valor entregue ao longo do tempo. Comparar com custo de oportunidade.</field>
        </record>

        <record id="objecao_tempo" model="crm.wealth.objecao">
            <field name="name">Falta de Tempo</field>
            <field name="tratativa_padrao">Explicar que a consultoria economiza tempo do cliente ao cuidar da estratégia.</field>
        </record>

        <record id="objecao_medo" model="crm.wealth.objecao">
            <field name="name">Medo de Investir</field>
            <field name="tratativa_padrao">Educar sobre riscos controlados e estratégias conservadoras. Mostrar casos de sucesso.</field>
        </record>

        <record id="objecao_complexidade" model="crm.wealth.objecao">
            <field name="name">Parece Muito Complexo</field>
            <field name="tratativa_padrao">Simplificar a explicação e mostrar que cuidaremos da complexidade por ele.</field>
        </record>

        <record id="objecao_confianca" model="crm.wealth.objecao">
            <field name="name">Falta de Confiança</field>
            <field name="tratativa_padrao">Apresentar credenciais, cases de sucesso e começar com plano menor.</field>
        </record>

        <record id="objecao_pensar" model="crm.wealth.objecao">
            <field name="name">Preciso Pensar</field>
            <field name="tratativa_padrao">Entender a real objeção por trás. Oferecer material adicional e follow-up agendado.</field>
        </record>

        <!-- ============================================================ -->
        <!-- DOCUMENTOS NECESSÁRIOS -->
        <!-- ============================================================ -->

        <record id="documento_rg_cnh" model="crm.wealth.documento">
            <field name="name">RG ou CNH</field>
            <field name="obrigatorio" eval="True"/>
        </record>

        <record id="documento_cpf" model="crm.wealth.documento">
            <field name="name">CPF</field>
            <field name="obrigatorio" eval="True"/>
        </record>

        <record id="documento_comprovante" model="crm.wealth.documento">
            <field name="name">Comprovante de Residência</field>
            <field name="obrigatorio" eval="True"/>
        </record>

        <record id="documento_extratos" model="crm.wealth.documento">
            <field name="name">Extratos de Investimentos</field>
            <field name="obrigatorio" eval="False"/>
        </record>

        <record id="documento_imposto_renda" model="crm.wealth.documento">
            <field name="name">Declaração de Imposto de Renda</field>
            <field name="obrigatorio" eval="False"/>
        </record>

        <record id="documento_carteira_atual" model="crm.wealth.documento">
            <field name="name">Carteira Atual de Investimentos</field>
            <field name="obrigatorio" eval="False"/>
        </record>

        <!-- ============================================================ -->
        <!-- CORRETORAS -->
        <!-- ============================================================ -->

        <record id="corretora_clear" model="crm.wealth.corretora">
            <field name="name">Clear</field>
        </record>

        <record id="corretora_genial" model="crm.wealth.corretora">
            <field name="name">Genial Investimentos</field>
        </record>

        <record id="corretora_xp" model="crm.wealth.corretora">
            <field name="name">XP Investimentos</field>
        </record>

        <record id="corretora_btg" model="crm.wealth.corretora">
            <field name="name">BTG Pactual</field>
        </record>

        <record id="corretora_inter" model="crm.wealth.corretora">
            <field name="name">Banco Inter</field>
        </record>

        <record id="corretora_nuinvest" model="crm.wealth.corretora">
            <field name="name">Nu Invest</field>
        </record>

        <record id="corretora_rico" model="crm.wealth.corretora">
            <field name="name">Rico</field>
        </record>

        <record id="corretora_avenue" model="crm.wealth.corretora">
            <field name="name">Avenue Securities</field>
        </record>

    </data>
</odoo>
