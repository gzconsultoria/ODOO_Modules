<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_asset_ref_tree" model="ir.ui.view">
        <field name="name">finance.asset.ref.tree</field>
        <field name="model">finance.asset.ref</field>
        <field name="arch" type="xml">
            <list>
                <field name="identifier"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="asset_class"/>
                <field name="provider_name"/>
                <field name="last_price"/>
            </list>
        </field>
    </record>

    <record id="view_finance_asset_ref_form" model="ir.ui.view">
        <field name="name">finance.asset.ref.form</field>
        <field name="model">finance.asset.ref</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="identifier"/>
                            <field name="name"/>
                            <field name="provider_name"/>
                        </group>
                        <group>
                            <field name="asset_type"/>
                            <field name="asset_class"/>
                            <field name="suitability_min_profile"/>
                        </group>
                        <group>
                            <field name="last_price"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_finance_asset_ref" model="ir.actions.act_window">
        <field name="name">Biblioteca de ativos</field>
        <field name="res_model">finance.asset.ref</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Views para finance.asset (ativos do cliente) -->
    <record id="view_finance_asset_tree" model="ir.ui.view">
        <field name="name">finance.asset.tree</field>
        <field name="model">finance.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="profile_id"/>
                <field name="reference_id"/>
                <field name="amount" widget="monetary"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_finance_asset_form" model="ir.ui.view">
        <field name="name">finance.asset.form</field>
        <field name="model">finance.asset</field>
        <field name="arch" type="xml">
            <form string="Ativo Patrimonial">
                <sheet>
                    <div class="oe_title">
                        <label for="reference_id" string="Qual ativo o cliente possui?"/>
                        <h1>
                            <field name="reference_id" placeholder="Ex: PETR4, Tesouro Selic 2029, CDB Banco X..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="💰 Valor do Ativo">
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="📋 Informações">
                            <field name="profile_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="📝 Observações">
                        <field name="notes" nolabel="1" placeholder="Ex: Aplicação de longo prazo, herança, investimento inicial..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Views para finance.liability (passivos) -->
    <record id="view_finance_liability_tree" model="ir.ui.view">
        <field name="name">finance.liability.tree</field>
        <field name="model">finance.liability</field>
        <field name="arch" type="xml">
            <list>
                <field name="profile_id"/>
                <field name="name"/>
                <field name="liability_type"/>
                <field name="outstanding_balance" widget="monetary"/>
                <field name="interest_rate" widget="percentage"/>
                <field name="maturity_date"/>
            </list>
        </field>
    </record>

    <record id="view_finance_liability_form" model="ir.ui.view">
        <field name="name">finance.liability.form</field>
        <field name="model">finance.liability</field>
        <field name="arch" type="xml">
            <form string="Passivo / Dívida">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nome da Dívida"/>
                        <h1>
                            <field name="name" placeholder="Ex: Financiamento Imóvel, Empréstimo Consignado..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="📋 Dados Básicos">
                            <field name="liability_type"/>
                            <field name="profile_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="💳 Condições Financeiras">
                            <field name="outstanding_balance" widget="monetary"/>
                            <field name="interest_rate" widget="percentage"/>
                            <field name="maturity_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_finance_investment_root" name="Investimentos" parent="finance_core.menu_finance_root" sequence="40"/>
    <menuitem id="menu_finance_asset_ref" parent="menu_finance_investment_root" name="Ativos cadastrados" action="action_finance_asset_ref" sequence="5" groups="finance_core.group_finance_supervisor"/>
</odoo>
