<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ====================================================================== -->
        <!-- ESTRUTURA DE 2 RAÍZES: ESCRITÓRIO + CLIENTES                          -->
        <!-- ====================================================================== -->
        
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- RAIZ 1: ESCRITÓRIO - Documentos internos da empresa                   -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- RAIZ 1: ESCRITÓRIO - Documentos internos da empresa                   -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        
        <record id="folder_escritorio" model="document_hub.folder">
            <field name="name">🏢 Escritório</field>
            <field name="description">Documentos e operações internas do escritório de consultoria.</field>
            <field name="visibility_administration">True</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- RAIZ 2: CLIENTES - Pastas criadas automaticamente ao ganhar lead      -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        
        <record id="folder_clientes" model="document_hub.folder">
            <field name="name">📁 Clientes</field>
            <field name="description">Pastas individuais de cada cliente, criadas automaticamente ao converter lead.</field>
            <field name="visibility_administration">True</field>
            <field name="visibility_salesman">True</field>
        </record>

        <!-- ====================================================================== -->
        <!-- SUBPASTAS DO ESCRITÓRIO                                               -->
        <!-- ====================================================================== -->
        
        <!-- CONTRATOS -->
        <record id="folder_escritorio_contratos" model="document_hub.folder">
            <field name="name">📝 Contratos</field>
            <field name="description">Contratos do escritório: fornecedores, prestadores de serviço, parcerias.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio" />
            <field name="visibility_administration">True</field>
        </record>

        <!-- PROPOSTAS COMERCIAIS -->
        <record id="folder_escritorio_propostas" model="document_hub.folder">
            <field name="name">📊 Propostas Comerciais</field>
            <field name="description">Templates de propostas, apresentações comerciais e materiais de venda.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio" />
            <field name="visibility_administration">True</field>
            <field name="visibility_salesman">True</field>
        </record>

        <!-- FINANCEIRO -->
        <record id="folder_escritorio_financeiro" model="document_hub.folder">
            <field name="name">💰 Financeiro</field>
            <field name="description">Documentos financeiros do escritório: notas fiscais, impostos, orçamentos.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio" />
            <field name="visibility_accounting">True</field>
            <field name="visibility_administration">True</field>
        </record>

        <record id="folder_financeiro_notas_fiscais" model="document_hub.folder">
            <field name="name">🧾 Notas Fiscais</field>
            <field name="description">Notas fiscais emitidas e recebidas pelo escritório.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_financeiro" />
            <field name="visibility_accounting">True</field>
        </record>

        <record id="folder_financeiro_impostos" model="document_hub.folder">
            <field name="name">🏛️ Impostos e Tributos</field>
            <field name="description">Declarações, guias de pagamento e documentação fiscal.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_financeiro" />
            <field name="visibility_accounting">True</field>
        </record>

        <record id="folder_financeiro_orcamentos" model="document_hub.folder">
            <field name="name">📑 Orçamentos</field>
            <field name="description">Orçamentos solicitados e aprovados.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_financeiro" />
            <field name="visibility_accounting">True</field>
        </record>

        <!-- MARKETING -->
        <record id="folder_escritorio_marketing" model="document_hub.folder">
            <field name="name">📢 Marketing</field>
            <field name="description">Materiais de marketing, campanhas e conteúdo institucional.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio" />
            <field name="visibility_administration">True</field>
            <field name="visibility_marketing">True</field>
        </record>

        <record id="folder_marketing_campanhas" model="document_hub.folder">
            <field name="name">🚀 Campanhas</field>
            <field name="description">Planejamento e materiais de campanhas de captação e relacionamento.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_marketing" />
            <field name="visibility_marketing">True</field>
        </record>

        <record id="folder_marketing_conteudo" model="document_hub.folder">
            <field name="name">✍️ Conteúdo Educacional</field>
            <field name="description">Artigos, e-books, webinars e materiais educativos.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_marketing" />
            <field name="visibility_marketing">True</field>
        </record>

        <record id="folder_marketing_institucional" model="document_hub.folder">
            <field name="name">🏆 Material Institucional</field>
            <field name="description">Apresentações da empresa, cases de sucesso e mídia kit.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_marketing" />
            <field name="visibility_marketing">True</field>
        </record>

        <!-- ADMINISTRATIVO -->
        <record id="folder_escritorio_administrativo" model="document_hub.folder">
            <field name="name">🏢 Administrativo</field>
            <field name="description">Documentos administrativos, RH, TI e processos internos.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio" />
            <field name="visibility_administration">True</field>
        </record>

        <record id="folder_administrativo_rh" model="document_hub.folder">
            <field name="name">👥 Recursos Humanos</field>
            <field name="description">Contratos de trabalho, treinamentos e documentação de colaboradores.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_administrativo" />
            <field name="visibility_hr">True</field>
            <field name="visibility_administration">True</field>
        </record>

        <record id="folder_administrativo_ti" model="document_hub.folder">
            <field name="name">💻 Tecnologia da Informação</field>
            <field name="description">Documentação de sistemas, licenças de software e políticas de segurança.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_administrativo" />
            <field name="visibility_administration">True</field>
        </record>

        <record id="folder_administrativo_inbox" model="document_hub.folder">
            <field name="name">📥 Caixa de Entrada</field>
            <field name="description">Documentos recém-recebidos aguardando classificação.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_administrativo" />
            <field name="visibility_administration">True</field>
        </record>

        <!-- Alias para compatibilidade com código existente -->
        <record id="folder_administration_inbox" model="document_hub.folder">
            <field name="name">Inbox (legacy)</field>
            <field name="description">Alias para compatibilidade - usar Caixa de Entrada.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_administrativo_inbox" />
            <field name="visibility_administration">True</field>
        </record>

        <!-- COMPLIANCE -->
        <record id="folder_escritorio_compliance" model="document_hub.folder">
            <field name="name">🔒 Compliance</field>
            <field name="description">Conformidade regulatória, políticas e auditorias.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio" />
            <field name="visibility_administration">True</field>
        </record>

        <record id="folder_compliance_pld" model="document_hub.folder">
            <field name="name">🕵️ PLD-FT</field>
            <field name="description">Prevenção à Lavagem de Dinheiro e Financiamento ao Terrorismo.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_compliance" />
            <field name="visibility_administration">True</field>
        </record>

        <record id="folder_compliance_lgpd" model="document_hub.folder">
            <field name="name">🔐 LGPD</field>
            <field name="description">Conformidade com a Lei Geral de Proteção de Dados.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_compliance" />
            <field name="visibility_administration">True</field>
        </record>

        <record id="folder_compliance_cvm" model="document_hub.folder">
            <field name="name">⚖️ Regulatório CVM/BACEN</field>
            <field name="description">Resoluções, instruções normativas e comunicações com órgãos reguladores.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_compliance" />
            <field name="visibility_administration">True</field>
        </record>

        <record id="folder_compliance_auditoria" model="document_hub.folder">
            <field name="name">🔍 Auditoria</field>
            <field name="description">Relatórios de auditoria interna/externa e planos de ação.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_compliance" />
            <field name="visibility_administration">True</field>
        </record>

        <record id="folder_compliance_politicas" model="document_hub.folder">
            <field name="name">📖 Políticas e Procedimentos</field>
            <field name="description">Manual de compliance, código de ética e procedimentos operacionais.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_compliance" />
            <field name="visibility_administration">True</field>
        </record>

        <!-- RELATÓRIOS GERENCIAIS -->
        <record id="folder_escritorio_relatorios" model="document_hub.folder">
            <field name="name">📈 Relatórios Gerenciais</field>
            <field name="description">Relatórios de gestão, dashboards e análises do escritório.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio" />
            <field name="visibility_administration">True</field>
        </record>

        <!-- PRODUTOS DE INVESTIMENTO -->
        <record id="folder_escritorio_produtos" model="document_hub.folder">
            <field name="name">🎯 Produtos de Investimento</field>
            <field name="description">Lâminas, regulamentos e documentos técnicos de produtos financeiros.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio" />
            <field name="visibility_administration">True</field>
            <field name="visibility_salesman">True</field>
        </record>

        <record id="folder_produtos_fundos" model="document_hub.folder">
            <field name="name">📚 Fundos de Investimento</field>
            <field name="description">Regulamentos, lâminas e relatórios mensais de fundos.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_produtos" />
            <field name="visibility_salesman">True</field>
        </record>

        <record id="folder_produtos_renda_fixa" model="document_hub.folder">
            <field name="name">💰 Renda Fixa</field>
            <field name="description">Prospectos de CDBs, LCIs, LCAs, debêntures e títulos públicos.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_produtos" />
            <field name="visibility_salesman">True</field>
        </record>

        <record id="folder_produtos_previdencia" model="document_hub.folder">
            <field name="name">🛡️ Previdência Privada</field>
            <field name="description">Regulamentos de PGBL, VGBL e planos de previdência.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_produtos" />
            <field name="visibility_salesman">True</field>
        </record>

        <record id="folder_produtos_estruturados" model="document_hub.folder">
            <field name="name">🎲 Produtos Estruturados</field>
            <field name="description">COEs, derivativos e produtos estruturados customizados.</field>
            <field name="parent_folder_id" ref="gz_finance_docs.folder_escritorio_produtos" />
            <field name="visibility_salesman">True</field>
        </record>

    </data>
</odoo>