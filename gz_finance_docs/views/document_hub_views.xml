<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================== ACTIONS PARA DOCUMENTOS ================== -->
        
        <!-- Action: Email Documents -->
        <record id="document_hub_mail_document_act" model="ir.actions.act_window">
            <field name="name">Documentos de Email</field>
            <field name="res_model">document_hub.document</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('privacy_doc', '=', 'mail')]</field>
            <field name="context">{'default_privacy_doc': 'mail'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crie seu primeiro documento de email
                </p>
                <p>
                    Documentos importados automaticamente de emails via IMAP.
                </p>
            </field>
        </record>

        <!-- Action: Company Documents -->
        <record id="document_hub_company_document_act" model="ir.actions.act_window">
            <field name="name">Documentos Empresariais</field>
            <field name="res_model">document_hub.document</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('privacy_doc', '=', 'company')]</field>
            <field name="context">{'default_privacy_doc': 'company'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crie seu primeiro documento empresarial
                </p>
                <p>
                    Documentos confidenciais da empresa.
                </p>
            </field>
        </record>

        <!-- ================== VIEWS PARA DOCUMENTOS ================== -->
        
        <!-- Tree/List View -->
        <record id="document_hub_document_tree_view" model="ir.ui.view">
            <field name="name">document.hub.document.tree</field>
            <field name="model">document_hub.document</field>
            <field name="arch" type="xml">
                <list string="Documents" sample="1">
                    <field name="name"/>
                    <field name="topic"/>
                    <field name="partner_id"/>
                    <field name="folder_id"/>
                    <field name="owner_id" widget="many2one_avatar_user"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="state" widget="badge" decoration-success="state == 'open'" decoration-muted="state == 'lock'"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="document_hub_document_form_view" model="ir.ui.view">
            <field name="name">document.hub.document.form</field>
            <field name="model">document_hub.document</field>
            <field name="arch" type="xml">
                <form string="Document">
                    <header>
                        <button name="action_lock_document" string="Bloquear" type="object" invisible="state == 'lock'" class="oe_highlight"/>
                        <button name="action_open_document" string="Desbloquear" type="object" invisible="state == 'open'" class="oe_highlight"/>
                        <field name="state" widget="statusbar" statusbar_visible="open,lock"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="topic" placeholder="ex: Contrato de projeto" required="1"/>
                                <field name="folder_id" options="{'no_create': True}"/>
                                <field name="partner_id"/>
                                <field name="project_id" invisible="not rel_is_project and not rel_is_parent_folder_project"/>
                            </group>
                            <group>
                                <field name="owner_id" widget="many2one_avatar_user"/>
                                <field name="privacy_doc"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                                <field name="rel_is_project" column_invisible="1"/>
                                <field name="rel_is_parent_folder_project" column_invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Arquivos">
                                <field name="file_ids" widget="many2many_binary" options="{'accepted_file_extensions': '*'}"/>
                            </page>
                            <page string="Descrição">
                                <field name="description" placeholder="Digite uma descrição dos documentos para que possam ser facilmente identificados."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="document_hub_document_search_view" model="ir.ui.view">
            <field name="name">document.hub.document.search</field>
            <field name="model">document_hub.document</field>
            <field name="arch" type="xml">
                <search string="Search Documents">
                    <field name="name"/>
                    <field name="topic"/>
                    <field name="partner_id"/>
                    <field name="folder_id"/>
                    <field name="tag_ids"/>
                    <filter string="Abertos" name="filter_open" domain="[('state', '=', 'open')]"/>
                    <filter string="Bloqueados" name="filter_lock" domain="[('state', '=', 'lock')]"/>
                    <separator/>
                    <filter string="Email" name="filter_mail" domain="[('privacy_doc', '=', 'mail')]"/>
                    <filter string="Empresarial" name="filter_company" domain="[('privacy_doc', '=', 'company')]"/>
                    <group string="Group By">
                        <filter string="Pasta" name="group_folder" context="{'group_by': 'folder_id'}"/>
                        <filter string="Proprietário" name="group_owner" context="{'group_by': 'owner_id'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>