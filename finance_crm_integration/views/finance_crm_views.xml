<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herança da view form do CRM Lead para adicionar integração com Finance Profile -->
    <record id="view_finance_crm_lead_form" model="ir.ui.view">
        <field name="name">crm.lead.form.finance</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Adiciona botão de ação rápida no button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button 
                    class="oe_stat_button" 
                    type="object" 
                    name="action_open_finance_profile"
                    icon="fa-user-circle"
                    invisible="finance_profile_id == False">
                    <field name="finance_profile_id" widget="statinfo" string="Perfil Financeiro"/>
                </button>
            </xpath>
            
            <!-- Adiciona nova página "Gestão de Investimentos" no notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="💼 Gestão de Investimentos" name="finance_consulting">
                    <div class="alert alert-info" role="alert" invisible="finance_profile_id != False">
                        <p class="mb-0">
                            <i class="fa fa-info-circle"/> 
                            <strong>Sincronização Automática:</strong> 
                            Quando este Lead atingir o estágio <strong>"🟤 Execução &amp; Acompanhamento"</strong>, 
                            um Perfil Financeiro será criado automaticamente com todos os dados preenchidos.
                        </p>
                    </div>
                    
                    <div class="alert alert-success" role="alert" invisible="finance_profile_id == False">
                        <p class="mb-0">
                            <i class="fa fa-check-circle"/> 
                            <strong>Perfil Sincronizado:</strong> 
                            Este Lead está vinculado ao Perfil Financeiro abaixo. 
                            As abas do perfil são controladas automaticamente pelo estágio do Lead.
                        </p>
                    </div>
                    
                    <group>
                        <group string="Perfil Financeiro Vinculado">
                            <field name="finance_profile_id" 
                                   options="{'no_create': True, 'no_open': False}"
                                   context="{'form_view_ref': 'finance_core.view_finance_profile_form'}"/>
                            <field name="finance_expected_aum" widget="monetary"/>
                        </group>
                        <group string="Informações da Consultoria">
                            <field name="finance_services"/>
                            <field name="finance_suitability_status"/>
                        </group>
                    </group>
                    
                    <!-- ====================================================== -->
                    <!-- SINCRONIZAÇÃO BIDIRECIONAL: Finance Profile → Lead    -->
                    <!-- ====================================================== -->
                    <separator string="📊 Dados Sincronizados do Finance Profile (Somente Leitura)" 
                              invisible="finance_profile_id == False"/>
                    
                    <div class="alert alert-warning" role="alert" invisible="finance_profile_id == False">
                        <p class="mb-0">
                            <i class="fa fa-lock"/> 
                            <strong>Campos Somente Leitura:</strong> 
                            Para editar esses dados, clique em <strong>"📂 Abrir Perfil Financeiro"</strong> abaixo.
                            Alterações lá serão refletidas aqui automaticamente.
                        </p>
                    </div>
                    
                    <!-- Dados Pessoais Sincronizados -->
                    <group string="👤 Dados Pessoais (Profile)" invisible="finance_profile_id == False">
                        <group>
                            <field name="finance_client_birthdate" readonly="1"/>
                            <field name="finance_spouse_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="finance_children_info" readonly="1"/>
                            <field name="finance_hobbies" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Objetivos Sincronizados -->
                    <group string="🎯 Objetivos (Profile)" invisible="finance_profile_id == False">
                        <group>
                            <field name="finance_main_goal" readonly="1"/>
                            <field name="finance_goal_amount" readonly="1" widget="monetary"/>
                        </group>
                        <group>
                            <field name="finance_monthly_contribution" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    
                    <!-- Diagnóstico Sincronizado -->
                    <group string="🔍 Diagnóstico SWOT (Profile)" invisible="finance_profile_id == False">
                        <field name="finance_diagnosis_summary" readonly="1" nolabel="1"/>
                    </group>
                    
                    <!-- Proposta Sincronizada -->
                    <group string="💼 Proposta Comercial (Profile)" invisible="finance_profile_id == False">
                        <group>
                            <field name="finance_contract_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="finance_estimated_revenue" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Ações">
                            <!-- Botão: Criar Perfil Manualmente (quando NÃO existe) -->
                            <button name="action_create_finance_profile" 
                                    type="object" 
                                    string="🚀 Criar Perfil Financeiro Agora" 
                                    class="btn btn-primary"
                                    help="Cria o Perfil Financeiro mesmo antes de atingir o estágio 'Execução'"
                                    invisible="finance_profile_id != False"/>
                            
                            <!-- Botão: Abrir Perfil (quando JÁ existe) -->
                            <button name="action_open_finance_profile" 
                                    type="object" 
                                    string="📂 Abrir Perfil Financeiro" 
                                    class="btn btn-success"
                                    help="Abre o formulário completo do Perfil Financeiro"
                                    invisible="finance_profile_id == False"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
