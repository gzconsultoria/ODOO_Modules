# ============================================
# ODOO PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# ⚠️  NUNCA COMMITAR ESTE ARQUIVO NO GIT! ⚠️
#
# Copie este arquivo para o servidor Contabo:
# scp .env.production user@servidor:/opt/odoo/.env
# ============================================

# PostgreSQL Database
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
POSTGRES_USER=odoo
POSTGRES_DB=gzcon

# Odoo Admin Password (primeira instalação)
ODOO_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD_456!

# Domain Configuration
DOMAIN=seu-dominio.com.br
EMAIL_ADMIN=admin@seu-dominio.com.br

# Backup Configuration
BACKUP_DIR=/opt/odoo/backups
BACKUP_RETENTION_DAYS=30

# SMTP Configuration (opcional - para emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SMTP_SSL=True

# ============================================
# SECURITY NOTES:
# - Use senhas fortes (mínimo 20 caracteres)
# - Habilite 2FA no servidor
# - Firewall: apenas portas 22, 80, 443
# - Backups diários automáticos
# ============================================
