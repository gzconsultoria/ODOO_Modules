<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- VIEWS: finance.compliance (NOVO SISTEMA INTEGRADO) -->
    <!-- ============================================================ -->
    
    <!-- Form View -->
    <record id="view_finance_compliance_integrated_form" model="ir.ui.view">
        <field name="name">finance.compliance.integrated.form</field>
        <field name="model">finance.compliance</field>
        <field name="arch" type="xml">
            <form string="Compliance">
                <header>
                    <field name="compliance_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" 
                                name="action_open_documents_folder" icon="fa-folder-open">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="document_count"/>
                                </span>
                                <span class="o_stat_text">Documentos</span>
                            </div>
                        </button>
                        
                        <button class="oe_stat_button" type="object" 
                                name="action_view_pending_signatures" icon="fa-clock-o"
                                invisible="pending_signatures_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="pending_signatures_count"/>
                                </span>
                                <span class="o_stat_text">Pendentes</span>
                            </div>
                        </button>
                        
                        <button class="oe_stat_button" type="object" 
                                name="action_send_contract_for_signature" icon="fa-pencil"
                                invisible="contract_signed">
                            <span class="o_stat_text">Enviar Contrato</span>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="folder_id" readonly="1"/>
                            <field name="compliance_score" widget="percentpie"/>
                        </group>
                        <group>
                            <field name="required_docs_count"/>
                            <field name="completed_docs_count"/>
                            <field name="pending_docs_count"/>
                            <field name="expired_docs_count" decoration-danger="expired_docs_count > 0"/>
                        </group>
                    </group>
                    
                    <group string="✅ Checklist Principal">
                        <group>
                            <field name="contract_signed" widget="boolean_toggle"/>
                            <field name="suitability_completed" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="personal_docs_complete" widget="boolean_toggle"/>
                            <field name="brokerage_selected" widget="boolean_toggle"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="📋 Checklist de Documentos">
                            <field name="required_document_ids" mode="tree">
                                <tree editable="bottom" 
                                      decoration-success="is_complete" 
                                      decoration-danger="is_expired" 
                                      decoration-warning="is_required and not is_complete">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="is_required" widget="boolean_toggle"/>
                                    <field name="is_complete" widget="boolean_toggle"/>
                                    <field name="document_id"/>
                                    <field name="sign_request_id"/>
                                    <field name="expiration_date"/>
                                    <field name="is_expired" invisible="1"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="🏦 Corretoras">
                            <field name="brokerage_ids" mode="kanban">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_card oe_kanban_global_click">
                                                <div class="oe_kanban_content">
                                                    <div class="o_kanban_record_title">
                                                        <strong><field name="name"/></strong>
                                                    </div>
                                                    <div class="o_kanban_record_subtitle">
                                                        <field name="code"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="view_finance_compliance_integrated_list" model="ir.ui.view">
        <field name="name">finance.compliance.integrated.list</field>
        <field name="model">finance.compliance</field>
        <field name="arch" type="xml">
            <list decoration-success="compliance_state == 'complete'"
                  decoration-danger="compliance_state == 'expired'"
                  decoration-warning="compliance_state == 'pending_signatures'">
                <field name="partner_id"/>
                <field name="profile_id"/>
                <field name="compliance_score" widget="progressbar"/>
                <field name="compliance_state" widget="badge"/>
                <field name="contract_signed" widget="boolean_toggle"/>
                <field name="suitability_completed" widget="boolean_toggle"/>
                <field name="personal_docs_complete" widget="boolean_toggle"/>
                <field name="brokerage_selected" widget="boolean_toggle"/>
                <field name="pending_signatures_count"/>
                <field name="document_count"/>
            </list>
        </field>
    </record>
    
    <!-- Kanban View -->
    <record id="view_finance_compliance_integrated_kanban" model="ir.ui.view">
        <field name="name">finance.compliance.integrated.kanban</field>
        <field name="model">finance.compliance</field>
        <field name="arch" type="xml">
            <kanban class="o_finance_compliance_kanban" default_group_by="compliance_state">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong><field name="partner_id"/></strong>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="profile_id"/>
                                </div>
                                <div class="o_finance_compliance_progress mt-2">
                                    <field name="compliance_score" widget="progressbar" options="{'current_value': 'compliance_score', 'max_value': 100}"/>
                                </div>
                                <div class="o_finance_compliance_checks mt-2">
                                    <span t-if="record.contract_signed.raw_value" class="badge badge-success">✅ Contrato</span>
                                    <span t-if="record.suitability_completed.raw_value" class="badge badge-success">✅ Suitability</span>
                                    <span t-if="record.personal_docs_complete.raw_value" class="badge badge-success">✅ Docs</span>
                                    <span t-if="record.brokerage_selected.raw_value" class="badge badge-success">✅ Corretora</span>
                                </div>
                            </div>
                            <div class="o_kanban_footer mt-2">
                                <span class="text-muted">
                                    <i class="fa fa-file-o"/> <field name="document_count"/> documentos
                                </span>
                                <span class="text-muted" t-if="record.pending_signatures_count.raw_value > 0">
                                    | <i class="fa fa-clock-o"/> <field name="pending_signatures_count"/> pendentes
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_finance_compliance_integrated_search" model="ir.ui.view">
        <field name="name">finance.compliance.integrated.search</field>
        <field name="model">finance.compliance</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="profile_id"/>
                <separator/>
                <filter string="Completo" name="filter_complete" domain="[('compliance_state', '=', 'complete')]"/>
                <filter string="Em Andamento" name="filter_in_progress" domain="[('compliance_state', '=', 'in_progress')]"/>
                <filter string="Pendente Assinaturas" name="filter_pending_sig" domain="[('compliance_state', '=', 'pending_signatures')]"/>
                <filter string="Documentos Vencidos" name="filter_expired" domain="[('compliance_state', '=', 'expired')]"/>
                <separator/>
                <filter string="Contrato Assinado" name="filter_contract_signed" domain="[('contract_signed', '=', True)]"/>
                <filter string="Suitability OK" name="filter_suitability_ok" domain="[('suitability_completed', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'compliance_state'}"/>
                    <filter name="group_partner" string="Cliente" domain="[]" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_finance_compliance_integrated" model="ir.actions.act_window">
        <field name="name">Compliance Integrado</field>
        <field name="res_model">finance.compliance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhum registro de compliance encontrado
            </p>
            <p>
                Compliance é criado automaticamente ao criar um Finance Profile.
            </p>
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- VIEWS: finance.brokerage -->
    <!-- ============================================================ -->
    
    <record id="view_finance_brokerage_list" model="ir.ui.view">
        <field name="name">finance.brokerage.list</field>
        <field name="model">finance.brokerage</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="website" widget="url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <record id="view_finance_brokerage_form" model="ir.ui.view">
        <field name="name">finance.brokerage.form</field>
        <field name="model">finance.brokerage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nome da Corretora"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Observações sobre a corretora..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_finance_brokerage" model="ir.actions.act_window">
        <field name="name">Corretoras</field>
        <field name="res_model">finance.brokerage</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- Menus -->
    <menuitem id="menu_finance_compliance_integrated" 
              name="Compliance Integrado" 
              parent="finance_core.menu_finance_root"
              action="action_finance_compliance_integrated"
              sequence="25"
              groups="finance_core.group_finance_compliance"/>
              
    <menuitem id="menu_finance_brokerage" 
              name="Corretoras" 
              parent="finance_core.menu_finance_root"
              action="action_finance_brokerage"
              sequence="90"
              groups="finance_core.group_finance_compliance"/>
    
</odoo>
