<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== TEMPLATE DO SNIPPET ===== -->
    <template id="s_fire_calculator" name="Calculadora FIRE">
        <section class="s_fire_calculator">
            <div class="container fire-calculator-content">
                
                <!-- Cabeçalho -->
                <div class="row fire-header">
                    <div class="col-12">
                        <h2>Calculadora Fire</h2>
                        <p>FIRE significa Financial Independence, Retire Early. Saiba quanto você precisa acumular para se aposentar mais cedo mantendo seu padrão de vida através dos seus investimentos.</p>
                    </div>
                </div>

                <div class="row">
                    <!-- ===== COLUNA FORMULÁRIO ===== -->
                    <div class="col-lg-6">
                        <div class="fire-card">
                            <h5>Dados de Entrada</h5>

                            <!-- Idades -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label for="currentAge">Idade atual</label>
                                    <input type="number" id="currentAge" value="30" min="18" max="100" step="1" class="form-control"/>
                                </div>
                                <div class="col-6">
                                    <label for="retirementAge">Idade desejada para aposentadoria</label>
                                    <input type="number" id="retirementAge" value="55" min="30" max="100" step="1" class="form-control"/>
                                </div>
                            </div>

                            <!-- Gastos e Renda -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label for="monthlyExpenses">Gastos mensais (R$)</label>
                                    <input type="number" id="monthlyExpenses" value="5000" min="0" step="100" class="form-control"/>
                                </div>
                                <div class="col-6">
                                    <label for="monthlyIncome">Renda mensal (R$)</label>
                                    <input type="number" id="monthlyIncome" value="8000" min="0" step="100" class="form-control"/>
                                </div>
                            </div>

                            <!-- Investimentos e Aportes -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label for="currentInvestments">Valor já investido (R$)</label>
                                    <input type="number" id="currentInvestments" value="100000" min="0" step="1000" class="form-control"/>
                                </div>
                                <div class="col-6">
                                    <label for="monthlySavings">Valor mensal para investir (R$)</label>
                                    <input type="number" id="monthlySavings" value="2000" min="0" step="100" class="form-control"/>
                                </div>
                            </div>

                            <!-- Barista FIRE Range -->
                            <div class="mb-3">
                                <label for="investmentRange">Quanto dos seus gastos mensais você quer cobrir com investimentos?</label>
                                <input type="range" id="investmentRange" min="0" max="100" step="5" value="20" class="form-range mt-2 mb-2"/>
                                <div class="text-center mb-2">
                                    <span id="investmentValue" style="font-weight: 600; font-size: 1.1rem;">20%</span>
                                </div>
                                <div class="d-flex justify-content-between text-small">
                                    <span>0%</span><span>25%</span><span>50%</span><span>75%</span><span>100%</span>
                                </div>
                            </div>

                            <!-- Ajuste de Gastos Futuros -->
                            <div class="mb-3">
                                <label for="expenseIncreaseRange">Você acredita que seus gastos futuros vão aumentar ou diminuir? (%)</label>
                                <input type="range" id="expenseIncreaseRange" min="-10" max="10" step="0.5" value="0" class="form-range mt-2 mb-2"/>
                                <div class="text-center mb-2">
                                    <span id="expenseIncreaseValue" style="font-weight: 600; font-size: 1.1rem;">0%</span>
                                </div>
                                <div class="d-flex justify-content-between text-small">
                                    <span>-10%</span><span>-5%</span><span>0%</span><span>+5%</span><span>+10%</span>
                                </div>
                                <small class="text-small d-block mt-2">Ajuste como seus gastos podem mudar no futuro (moradia, saúde, estilo de vida, etc.)</small>
                            </div>

                            <!-- Opções Avançadas -->
                            <div class="accordion mt-4">
                                <div class="accordion-item">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#advancedOptions">
                                        <h6 class="accordion-header">
                                            <i class="fa fa-cog me-2"></i>
                                            Opções Avançadas
                                        </h6>
                                    </button>
                                    <div id="advancedOptions" class="accordion-collapse collapse">
                                        <div class="accordion-body">
                                            
                                            <!-- SWR -->
                                            <div class="mb-3">
                                                <label for="withdrawalRateRange">Qual porcentagem do seu patrimônio você pretende usar por ano? - SWR (%)</label>
                                                <input type="range" id="withdrawalRateRange" min="0" max="6" step="0.5" value="4" class="form-range mt-2 mb-2"/>
                                                <div class="text-center mb-2">
                                                    <span id="withdrawalRateValue" style="font-weight: 600; font-size: 1.1rem;">4%</span>
                                                </div>
                                                <div class="d-flex justify-content-between text-small">
                                                    <span>0%</span><span>2%</span><span>4%</span><span>6%</span>
                                                </div>
                                                <small class="text-small d-block mt-2">Uma taxa de retirada de até 4% ao ano é considerada segura em cenários de inflação.</small>
                                            </div>

                                            <!-- Retorno e Inflação -->
                                            <div class="row mb-3">
                                                <div class="col-6">
                                                    <label for="expectedReturn">Retorno Anual Esperado (%)</label>
                                                    <input type="number" id="expectedReturn" value="12" step="0.1" min="0" max="30" class="form-control"/>
                                                </div>
                                                <div class="col-6">
                                                    <label for="inflationRate">Taxa de Inflação Anual (%)</label>
                                                    <input type="number" id="inflationRate" value="4" step="0.1" min="0" max="10" class="form-control"/>
                                                </div>
                                            </div>

                                            <!-- Modo Real -->
                                            <div class="form-check form-switch mb-2">
                                                <input type="checkbox" id="realMode" class="form-check-input" checked="checked"/>
                                                <label for="realMode" class="form-check-label">
                                                    <span id="realModeLabel">Considerar efeito da inflação nos cálculos</span>
                                                </label>
                                            </div>
                                            <small class="text-small">
                                                Ativado: calcula tudo em termos reais (retorno ajustado pela inflação).<br/>
                                                Desativado: calcula em termos nominais (sem ajuste por inflação).
                                            </small>

                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- ===== COLUNA RESULTADOS ===== -->
                    <div class="col-lg-6">
                        
                        <!-- Resumo da Situação -->
                        <div class="fire-card fire-summary-card">
                            <h5><i class="fa fa-lightbulb"></i> Resumo da sua situação</h5>
                            
                            <!-- Métricas Rápidas -->
                            <div class="row mt-3">
                                <div class="col-4">
                                    <div class="summary-metric" style="background: rgba(156, 39, 176, 0.1);">
                                        <div class="summary-metric-value" style="color: #9c27b0;" id="expensesCovered">-</div>
                                        <div class="summary-metric-label">dos gastos cobertos</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="summary-metric" style="background: rgba(33, 150, 243, 0.1);">
                                        <div class="summary-metric-value" style="color: #2196f3;" id="currentRunway">-</div>
                                        <div class="summary-metric-label">reserva de emergência</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="summary-metric" style="background: rgba(76, 175, 80, 0.1);">
                                        <div class="summary-metric-value" style="color: #4caf50;" id="savingsRate">-</div>
                                        <div class="summary-metric-label">taxa de poupança</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Avisos Inteligentes -->
                            <div id="smartWarnings" class="mt-3" style="display:none;"></div>

                            <!-- Badges de Conquista -->
                            <div class="row mt-3">
                                <div class="col-4">
                                    <div class="milestone-badge" style="background: rgba(255, 193, 7, 0.08); border: 1px solid rgba(255, 193, 7, 0.3);">
                                        <div class="milestone-icon" id="milestone250kIcon">🏆</div>
                                        <div class="milestone-value" style="color: #ff9800;">R$ 250K</div>
                                        <div class="milestone-status" id="milestone250kStatus">-</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="milestone-badge" style="background: rgba(156, 39, 176, 0.08); border: 1px solid rgba(156, 39, 176, 0.3);">
                                        <div class="milestone-icon" id="milestone500kIcon">🏆</div>
                                        <div class="milestone-value" style="color: #9c27b0;">R$ 500K</div>
                                        <div class="milestone-status" id="milestone500kStatus">-</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="milestone-badge" style="background: rgba(76, 175, 80, 0.08); border: 1px solid rgba(76, 175, 80, 0.3);">
                                        <div class="milestone-icon" id="milestone1MIcon">🏆</div>
                                        <div class="milestone-value" style="color: #4caf50;">R$ 1M</div>
                                        <div class="milestone-status" id="milestone1MStatus">-</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- FIRE Tradicional -->
                        <div class="fire-card mt-3">
                            <h5><i class="fa fa-fire text-danger"></i> FIRE Tradicional - Independência Total</h5>
                            
                            <div class="progress-block">
                                <div class="d-flex justify-content-between">
                                    <span>Progresso:</span>
                                    <span id="fireProgressPercent">0%</span>
                                </div>
                                <div class="progress-holder">
                                    <div id="fireProgressBar" class="progress-bar" style="width:0%"></div>
                                </div>
                                <div class="d-flex justify-content-between mt-2 text-small">
                                    <small>Atual: <span id="fireCurrentAmount">R$ 0,00</span></small>
                                    <small>Meta: <span id="fireTargetAmount">R$ 0,00</span></small>
                                </div>
                            </div>

                            <div id="statusAlert" class="alert alert-warning mt-3">
                                <p id="currentStatus" class="mb-0">Calculando...</p>
                            </div>
                        </div>

                        <!-- Barista FIRE -->
                        <div class="fire-card mt-3">
                            <h5><i class="fa fa-coffee text-danger"></i> Barista FIRE - Liberdade Parcial</h5>
                            
                            <div class="progress-block">
                                <div class="d-flex justify-content-between">
                                    <span>Progresso:</span>
                                    <span id="baristaProgress">0%</span>
                                </div>
                                <div class="progress-holder">
                                    <div id="baristaProgressBar" class="progress-bar" style="width:0%; background: linear-gradient(90deg, #795548 0%, #5d4037 100%);"></div>
                                </div>
                                <div class="d-flex justify-content-between mt-2 text-small">
                                    <small>Valor necessário: <span id="baristaTarget">R$ 0,00</span></small>
                                    <small>Renda part-time: <span id="baristaPartTime">R$ 0,00</span></small>
                                </div>
                            </div>

                            <div class="alert alert-info mt-3">
                                <p id="baristaPeriod" class="mb-0">Calculando...</p>
                            </div>
                        </div>

                        <!-- Coast FIRE -->
                        <div class="fire-card mt-3">
                            <h5><i class="fa fa-water text-info"></i> Coast FIRE - Piloto Automático</h5>
                            
                            <div class="progress-block">
                                <div class="d-flex justify-content-between">
                                    <span>Progresso:</span>
                                    <span id="coastProgress">0%</span>
                                </div>
                                <div class="progress-holder">
                                    <div id="coastProgressBar" class="progress-bar" style="width:0%; background: linear-gradient(90deg, #00bcd4 0%, #0097a7 100%);"></div>
                                </div>
                                <div class="d-flex justify-content-between mt-2 text-small">
                                    <small>Valor necessário: <span id="coastRequired">R$ 0,00</span></small>
                                    <small>Valor Futuro: <span id="coastGrowth">R$ 0,00</span></small>
                                </div>
                            </div>

                            <div class="alert alert-info mt-3">
                                <p id="coastPeriod" class="mb-0">Calculando...</p>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Como Funciona (Acordeão) -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="accordion">
                            <div class="accordion-item">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#howItWorks">
                                    <h6 class="accordion-header">
                                        <i class="fa fa-question-circle me-2" style="color: #9c27b0;"></i>
                                        Como Funciona
                                    </h6>
                                </button>
                                <div id="howItWorks" class="accordion-collapse collapse">
                                    <div class="accordion-body">
                                        <h6><i class="fa fa-fire"></i> FIRE</h6>
                                        <p><strong>Objetivo:</strong> alcançar a independência financeira total.</p>
                                        <p><strong>Como funciona:</strong> acumular patrimônio suficiente para que os rendimentos dos investimentos cubram 
                                        <em>100% dos gastos anuais</em>, sem precisar de renda ativa.</p>
                                        <p><strong>Regra de bolso:</strong> famosa regra dos 4% (SWR – Safe Withdrawal Rate).</p>
                                        <hr/>

                                        <h6><i class="fa fa-coffee"></i> Barista FIRE</h6>
                                        <p><strong>Objetivo:</strong> independência parcial.</p>
                                        <p><strong>Como funciona:</strong> a carteira cobre uma parte dos gastos, e o restante vem de uma atividade de renda complementar 
                                        (trabalho leve, meio período, algo prazeroso — daí o "barista").</p>
                                        <hr/>

                                        <h6><i class="fa fa-water"></i> Coast FIRE</h6>
                                        <p><strong>Objetivo:</strong> "alcançar a velocidade de cruzeiro".</p>
                                        <p><strong>Como funciona:</strong> acumular cedo o valor suficiente que, mesmo sem mais aportes, crescerá sozinho até o FIRE tradicional.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </template>

    <!-- ===== REGISTRO DO SNIPPET NO EDITOR ===== -->
    <template id="snippet_fire_calculator" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']" position="inside">
            <t t-snippet="Calculadora_FIRE.s_fire_calculator" 
               t-thumbnail="/Calculadora_FIRE/static/description/icon.png">
                <div class="oe_snippet_thumbnail">
                    <i class="fa fa-fire fa-2x text-danger"></i>
                    <span class="oe_snippet_thumbnail_title">Calculadora FIRE</span>
                </div>
                <section class="oe_snippet_body s_fire_calculator"/>
            </t>
        </xpath>
    </template>

</odoo>
